rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------------
    // Zentrale Auth- und Account-Enforcement-Prüfung
    // ---------------------------------------------------------------------
    //
    // isAuthenticated() bedeutet ausschließlich:
    // Es existiert eine gültige Firebase-Auth-Sitzung.
    //
    // isSignedIn() bedeutet für die normalen Luma-Regeln zusätzlich:
    // Das Konto besitzt KEINE aktuell blockierende Kontomaßnahme.
    //
    // Dadurch übernehmen auch ältere App-Versionen diese Sperrlogik
    // serverseitig, ohne dass deren Flutter-Code aktualisiert werden muss.
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasBlockingAccountEnforcement() {
      let statePath =
        /databases/$(database)/documents/accountEnforcementStates/$(request.auth.uid);

      return isAuthenticated()
        && exists(statePath)
        && get(statePath).data.get('isActive', false) == true
        && get(statePath).data.get('type', 'none') in [
          'temporarySuspension',
          'permanentSuspension',
          'safetyHold',
          'disabled'
        ]
        && (
          get(statePath).data.get('expiresAt', null) == null
          || get(statePath).data.get('expiresAt', null) > request.time
        );
    }

    function isSignedIn() {
      return isAuthenticated()
        && !hasBlockingAccountEnforcement();
    }

    // Zentrale Prüfung für den internen Verifikations-Adminbereich.
    // Unterstützt sowohl Firebase Custom Claims als auch das aktive
    // Firestore-Dokument admins/{uid}. Dadurch verwenden App und Rules
    // dasselbe Berechtigungsmodell.
    function hasVerificationAdminClaim() {
      return isSignedIn()
        && (
          request.auth.token.get('superAdmin', false) == true
          || request.auth.token.get('admin', false) == true
          || request.auth.token.get('verificationAdmin', false) == true
        );
    }

    function hasActiveVerificationAdminDocument() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.get('isActive', false) == true
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.get('role', '') in [
          'admin',
          'superAdmin'
        ];
    }

    function isVerificationAdmin() {
      return hasVerificationAdminClaim()
        || hasActiveVerificationAdminDocument();
    }

    // Zentrale Prüfung für die Luma-Plattformadministration.
    // Diese Rollen steuern Moderation und Account-Enforcement und sind
    // bewusst von normalen Page-Rollen getrennt.
    function hasLumaAdminClaim() {
      return isSignedIn()
        && (
          request.auth.token.get('superAdmin', false) == true
          || request.auth.token.get('admin', false) == true
          || request.auth.token.get('moderator', false) == true
          || request.auth.token.get('role', '') in [
            'superAdmin',
            'admin',
            'moderator'
          ]
        );
    }

    function hasActiveLumaAdminDocument() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.get('isActive', false) == true
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.get('role', '') in [
          'superAdmin',
          'admin',
          'moderator'
        ];
    }

    function isLumaAdmin() {
      return hasLumaAdminClaim()
        || hasActiveLumaAdminDocument();
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidFriendshipStatus(status) {
      return status in ['pending', 'accepted', 'declined', 'blocked'];
    }

    function isFriendshipParticipant() {
      return isSignedIn()
        && (
          (
            resource.data.participants is list
            && request.auth.uid in resource.data.participants
          )
          || resource.data.requesterUserId == request.auth.uid
          || resource.data.addresseeUserId == request.auth.uid
        );
    }

    function isIncomingFriendshipParticipant() {
      return isSignedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
    }

    function isValidFriendshipCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'requesterUserId',
          'addresseeUserId',
          'status',
          'createdAt',
          'updatedAt',
          'participants'
        ])
        && request.resource.data.requesterUserId == request.auth.uid
        && request.resource.data.addresseeUserId is string
        && request.resource.data.addresseeUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.addresseeUserId in request.resource.data.participants
        && request.resource.data.createdAt != null
        && request.resource.data.updatedAt != null;
    }

    function isValidFriendshipUpdate() {
      return isSignedIn()
        && isFriendshipParticipant()
        && request.resource.data.requesterUserId == resource.data.requesterUserId
        && request.resource.data.addresseeUserId == resource.data.addresseeUserId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && resource.data.requesterUserId in request.resource.data.participants
        && resource.data.addresseeUserId in request.resource.data.participants
        && isValidFriendshipStatus(request.resource.data.status)
        && request.resource.data.updatedAt != null;
    }

    function isValidFriendMirror(ownerUserId, friendUserId) {
      return isSignedIn()
        && ownerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'friendUserId',
          'friendshipId',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.friendUserId == friendUserId
        && request.resource.data.friendshipId is string
        && request.resource.data.status == 'accepted'
        && request.resource.data.createdAt != null
        && request.resource.data.updatedAt != null;
    }

    function isValidBlockedUserWrite(ownerUserId, blockedUserId) {
      return isSignedIn()
        && ownerUserId == request.auth.uid
        && blockedUserId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'blockedUserId',
          'blockerUserId',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.blockedUserId == blockedUserId
        && request.resource.data.blockerUserId == request.auth.uid
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt != null;
    }


    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidVisibility(visibility) {
      return visibility in ['public', 'friends', 'private'];
    }

    function postExists(postId) {
      return exists(/databases/$(database)/documents/feed_posts/$(postId));
    }

    function isPostOwner() {
      return isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    function isIncomingPostOwner() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid;
    }

    function isValidOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isValidNotificationType(type) {
      return type in [
        'postLike',
        'postComment',
        'commentReply',
        'commentLike',
        'postShare',
        'friendRequest',
        'friendRequestAccepted',
        'storyView',
        'storyReaction',
        'storyReply',
        'mention',
        'groupActivity',
        'pageActivity',
        'newFollower',
        'relationshipRequest',
        'relationshipAccepted',
        'relationshipRejected',
        'relationshipCancelled',
        'relationshipRemoved',
        'relationshipChanged',
        'securityAlert',
        'systemUpdate'
      ];
    }

    function isValidNotificationPriority(priority) {
      return priority in ['high', 'medium', 'low'];
    }

    function isValidNotificationTargetType(targetType) {
      return targetType in [
        'post',
        'comment',
        'profile',
        'story',
        'group',
        'page',
        'relationship',
        'system'
      ];
    }

    function isValidFeedReactionType(type) {
      return type in [
        'like',
        'heart',
        'love',
        'haha',
        'wow',
        'sad',
        'angry',
        'fire',
        'applause'
      ];
    }


    function isValidCommentReactionCounts(counts, totalCount) {
      return counts is map
        && counts.keys().hasOnly([
          'like',
          'love',
          'haha',
          'wow',
          'sad',
          'angry'
        ])
        && counts.get('like', 0) is int
        && counts.get('love', 0) is int
        && counts.get('haha', 0) is int
        && counts.get('wow', 0) is int
        && counts.get('sad', 0) is int
        && counts.get('angry', 0) is int
        && counts.get('like', 0) >= 0
        && counts.get('love', 0) >= 0
        && counts.get('haha', 0) >= 0
        && counts.get('wow', 0) >= 0
        && counts.get('sad', 0) >= 0
        && counts.get('angry', 0) >= 0
        && totalCount is int
        && totalCount >= 0
        && totalCount ==
          counts.get('like', 0)
          + counts.get('love', 0)
          + counts.get('haha', 0)
          + counts.get('wow', 0)
          + counts.get('sad', 0)
          + counts.get('angry', 0);
    }

    function isCommentThreadOwner(postId, parentCommentId) {
      return isSignedIn()
        && parentCommentId is string
        && parentCommentId.size() > 0
        && exists(
          /databases/$(database)/documents/feed_posts/$(postId)/comments/$(parentCommentId)
        )
        && get(
          /databases/$(database)/documents/feed_posts/$(postId)/comments/$(parentCommentId)
        ).data.authorId == request.auth.uid;
    }


    function isValidOptionalFriendRequestStatus(status) {
      return status == null || status in ['pending', 'accepted', 'removed', 'blocked'];
    }

    function isValidNotificationDocument(userId, notificationId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'userId',
        'actorUserId',
        'actorDisplayName',
        'actorUsername',
        'actorAvatarUrl',
        'type',
        'priority',
        'targetType',
        'referenceId',
        'secondaryReferenceId',
        'friendshipId',
        'previewText',
        'contentThumbnailUrl',
        'reactionType',
        'groupKey',
        'deduplicationKey',
        'groupCount',
        'actorUserIds',
        'actorDisplayNames',
        'groupedNotificationIds',
        'unreadNotificationIds',
        'title',
        'body',
        'createdAt',
        'updatedAt',
        'readAt',
        'isRead',
        'isActionable',
        'schemaVersion',
        'friendRequestStatus'
      ])
      && request.resource.data.id == notificationId
      && request.resource.data.userId == userId
      && isValidOptionalString(request.resource.data.actorUserId, 160)
      && isValidOptionalString(request.resource.data.actorDisplayName, 120)
      && isValidOptionalString(request.resource.data.actorUsername, 80)
      && isValidOptionalString(request.resource.data.actorAvatarUrl, 4096)
      && isValidNotificationType(request.resource.data.type)
      && isValidNotificationPriority(request.resource.data.priority)
      && isValidNotificationTargetType(request.resource.data.targetType)
      && request.resource.data.referenceId is string
      && request.resource.data.referenceId.size() <= 220
      && (
        request.resource.data.targetType == 'system'
        || request.resource.data.referenceId.size() > 0
      )
      && isValidOptionalString(request.resource.data.secondaryReferenceId, 220)
      && isValidOptionalString(request.resource.data.friendshipId, 220)
      && isValidOptionalString(request.resource.data.previewText, 700)
      && isValidOptionalString(request.resource.data.contentThumbnailUrl, 4096)
      && (
        !('reactionType' in request.resource.data)
        || isValidFeedReactionType(request.resource.data.reactionType)
      )
      && isValidOptionalString(request.resource.data.groupKey, 300)
      && isValidOptionalString(request.resource.data.deduplicationKey, 300)
      && request.resource.data.groupCount is int
      && request.resource.data.groupCount >= 1
      && request.resource.data.groupCount <= 1000000
      && request.resource.data.actorUserIds is list
      && request.resource.data.actorUserIds.size() <= 100
      && request.resource.data.actorDisplayNames is list
      && request.resource.data.actorDisplayNames.size() <= 100
      && request.resource.data.groupedNotificationIds is list
      && request.resource.data.groupedNotificationIds.size() <= 400
      && request.resource.data.unreadNotificationIds is list
      && request.resource.data.unreadNotificationIds.size() <= 400
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 140
      && request.resource.data.body is string
      && request.resource.data.body.size() > 0
      && request.resource.data.body.size() <= 700
      && request.resource.data.createdAt != null
      && request.resource.data.updatedAt != null
      && isValidNullableTimestamp(request.resource.data.readAt)
      && request.resource.data.isRead is bool
      && request.resource.data.isActionable is bool
      && request.resource.data.schemaVersion is int
      && request.resource.data.schemaVersion >= 1
      && request.resource.data.schemaVersion <= 20
      && isValidOptionalFriendRequestStatus(
        request.resource.data.friendRequestStatus
      );
    }

    // Story-Interaktionen dürfen eine Benachrichtigung direkt beim
    // Story-Autor erzeugen bzw. bei einer geänderten Reaktion aktualisieren.
    // Die Prüfung bleibt eng auf Story-Antworten und Story-Reaktionen begrenzt.
    function isValidStoryInteractionNotification(userId, notificationId) {
      let data = request.resource.data;

      return isSignedIn()
        && data.get('id', '') == notificationId
        && data.get('userId', '') == userId
        && data.get('actorUserId', '') == request.auth.uid
        && data.get('type', '') in ['storyReply', 'storyReaction']
        && data.get('targetType', '') == 'story'
        && data.get('referenceId', '') is string
        && data.get('referenceId', '').size() > 0
        && exists(
          /databases/$(database)/documents/stories/$(data.get('referenceId', ''))
        )
        && get(
          /databases/$(database)/documents/stories/$(data.get('referenceId', ''))
        ).data.authorId == userId
        && get(
          /databases/$(database)/documents/stories/$(data.get('referenceId', ''))
        ).data.isArchived == false
        && get(
          /databases/$(database)/documents/stories/$(data.get('referenceId', ''))
        ).data.expiresAt is timestamp
        && get(
          /databases/$(database)/documents/stories/$(data.get('referenceId', ''))
        ).data.expiresAt > request.time
        && data.get('createdAt', null) != null
        && data.get('updatedAt', null) != null
        && data.get('isRead', true) == false
        && data.get('isActionable', false) == true;
    }

    function isValidNotificationActorUpdate(userId, notificationId) {
      return isSignedIn()
        && resource.data.get('actorUserId', '') == request.auth.uid
        && request.resource.data.get('actorUserId', '') == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.id == notificationId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == userId
        && resource.data.get('type', '') == 'commentLike'
        && request.resource.data.get('type', '') == 'commentLike'
        && resource.data.get('targetType', '') == 'comment'
        && request.resource.data.get('targetType', '') == 'comment'
        && request.resource.data.referenceId == resource.data.referenceId
        && request.resource.data.secondaryReferenceId ==
            resource.data.secondaryReferenceId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidNotificationDocument(userId, notificationId);
    }

    function canDeleteOwnCommentReactionNotification(userId) {
      return isSignedIn()
        && resource.data.get('userId', '') == userId
        && resource.data.get('actorUserId', '') == request.auth.uid
        && resource.data.get('type', '') == 'commentLike'
        && resource.data.get('targetType', '') == 'comment';
    }

    function isValidNotificationUpdate(userId, notificationId) {
      let changedKeys =
        request.resource.data.diff(resource.data).affectedKeys();

      return isOwner(userId)
        && changedKeys.hasOnly([
          'isRead',
          'readAt',
          'updatedAt',
          'friendRequestStatus',
          'type',
          'priority',
          'title',
          'body'
        ])
        && request.resource.data.get('isRead', false) is bool
        && isValidNullableTimestamp(
          request.resource.data.get('readAt', null)
        )
        && request.resource.data.get('updatedAt', null) != null
        && isValidOptionalFriendRequestStatus(
          request.resource.data.get('friendRequestStatus', null)
        )
        && (
          !changedKeys.hasAny([
            'type',
            'priority',
            'title',
            'body',
            'friendRequestStatus'
          ])
          ||
          (
            resource.data.get('type', '') == 'friendRequest'
            && request.resource.data.get(
              'type',
              resource.data.get('type', '')
            ) in [
              'friendRequest',
              'friendRequestAccepted'
            ]
            && isValidNotificationPriority(
              request.resource.data.get(
                'priority',
                resource.data.get('priority', 'medium')
              )
            )
            && request.resource.data.get('title', '') is string
            && request.resource.data.get('title', '').size() > 0
            && request.resource.data.get('title', '').size() <= 140
            && request.resource.data.get('body', '') is string
            && request.resource.data.get('body', '').size() > 0
            && request.resource.data.get('body', '').size() <= 700
          )
        );
    }

    function isConversationParticipant() {
      return isSignedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    function isConversationLookupAllowed(conversationId) {
      return isConversationParticipant()
        || (
          isSignedIn()
          && !exists(/databases/$(database)/documents/conversations/$(conversationId))
          && conversationId.matches('direct_.*' + request.auth.uid + '.*')
        );
    }

    function isSafeConversationListQuery() {
      return isSignedIn()
        && request.query.limit <= 100;
    }

    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isParticipantOfConversation(conversationId) {
      return isSignedIn()
        && conversationExists(conversationId)
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }

    function isValidMessengerPresenceDocument(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'userId',
          'isOnline',
          'lastActiveAt',
          'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.isOnline is bool
        && request.resource.data.lastActiveAt != null
        && request.resource.data.updatedAt != null;
    }

    function isValidMessengerPresenceUpdate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isOnline',
          'lastActiveAt',
          'updatedAt'
        ])
        && request.resource.data.isOnline is bool
        && request.resource.data.lastActiveAt != null
        && request.resource.data.updatedAt != null;
    }

    function isValidMessengerActivityState(state) {
      return state in [
        'idle',
        'typing',
        'recordingAudio',
        'uploadingMedia',
        'sendingMessage'
      ];
    }

    function isValidConversationActivityCreate(
      conversationId,
      activityUserId
    ) {
      return isParticipantOfConversation(conversationId)
        && activityUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'conversationId',
          'userId',
          'state',
          'updatedAt',
          'expiresAt'
        ])
        && request.resource.data.conversationId == conversationId
        && request.resource.data.userId == request.auth.uid
        && isValidMessengerActivityState(
          request.resource.data.state
        )
        && request.resource.data.updatedAt != null
        && (
          request.resource.data.state == 'idle'
          || request.resource.data.expiresAt != null
        );
    }

    function isValidConversationActivityUpdate(
      conversationId,
      activityUserId
    ) {
      return isParticipantOfConversation(conversationId)
        && activityUserId == request.auth.uid
        && resource.data.conversationId == conversationId
        && resource.data.userId == request.auth.uid
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'state',
          'updatedAt',
          'expiresAt'
        ])
        && isValidMessengerActivityState(
          request.resource.data.state
        )
        && request.resource.data.updatedAt != null
        && (
          request.resource.data.state == 'idle'
          || request.resource.data.expiresAt != null
        );
    }

    function isValidConversationCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'participantIds',
          'participants',
          'lastMessagePreview',
          'lastMessageSenderId',
          'lastMessageType',
          'lastMessageAt',
          'createdAt',
          'updatedAt',
          'unreadCountsByUserId',
          'pinnedUserIds',
          'mutedUserIds',
          'archivedUserIds',
          'deletedForUserIds',
          'chatBackgroundPresetsByUserId',
          'friendshipStatusesByUserId',
          'messageCount',
          'hasMessages'
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 20
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 20
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() <= 500
        && request.resource.data.lastMessageSenderId is string
        && request.resource.data.lastMessageSenderId.size() <= 160
        && (
          request.resource.data.lastMessageSenderId.size() == 0
          || request.resource.data.lastMessageType in [
            'text',
            'image',
            'audio',
            'file'
          ]
        )
        && request.resource.data.unreadCountsByUserId is map
        && request.resource.data.pinnedUserIds is list
        && request.resource.data.mutedUserIds is list
        && (
          !('archivedUserIds' in request.resource.data)
          || request.resource.data.archivedUserIds is list
        )
        && (
          !('deletedForUserIds' in request.resource.data)
          || request.resource.data.deletedForUserIds is list
        )
        && (
          !('chatBackgroundPresetsByUserId' in request.resource.data)
          || request.resource.data.chatBackgroundPresetsByUserId is map
        )
        && (
          !('friendshipStatusesByUserId' in request.resource.data)
          || request.resource.data.friendshipStatusesByUserId is map
        )
        && (
          !('messageCount' in request.resource.data)
          || request.resource.data.messageCount is int
        )
        && (
          !('hasMessages' in request.resource.data)
          || request.resource.data.hasMessages is bool
        )
        && request.resource.data.createdAt != null
        && request.resource.data.updatedAt != null
        && request.resource.data.lastMessageAt != null;
    }

    function isValidConversationUpdate() {
      return isConversationParticipant()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessagePreview',
          'lastMessageSenderId',
          'lastMessageType',
          'lastMessageAt',
          'updatedAt',
          'unreadCountsByUserId',
          'pinnedUserIds',
          'mutedUserIds',
          'archivedUserIds',
          'deletedForUserIds',
          'chatBackgroundPresetsByUserId',
          'friendshipStatusesByUserId',
          'messageCount',
          'hasMessages'
        ])
        && (
          !('lastMessagePreview' in request.resource.data)
          || (
