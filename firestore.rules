        'dailySummaryEnabled',
        'securityNotificationsEnabled',
        'systemUpdateNotificationsEnabled',
        'adminSecurityPriorityNotificationsEnabled',
        'moderationNotificationsEnabled',
        'notificationHistoryEnabled',
        'notificationGroupingEnabled',
        'quietModeAllowSecurityAlerts',
        'notificationPriorityMode',
        'digestDeliveryMode',
        'notificationGroupingMode',
        'blockedUsersProtectionEnabled',
        'restrictedInteractionsEnabled',
        'mutedUsersHiddenFromFeed',
        'hideRestrictedUsersComments',
        'appAppearanceMode',
        'appAccentPreference',
        'appInterfaceDensity',
        'reduceMotionEnabled',
        'highContrastModeEnabled',
        'useSystemTextScale',
        'showAppearancePreviewCards',
        'contactPermission',
        'connectionsVisibility',
        'profilePostsVisibility',
        'profilePhotosVisibility',
        'profileSearchVisibility',
        'profileTaggingPermission',
        'allowProfileScreenshotWarning',
        'allowProfileForwarding',
        'allowActivityStatusVisibility',
        'allowMutualFriendsPreview',
        'requireApprovalForProfileTags',
        'updatedAt',
        'resetAt',
        'migratedAt'
      ])
      && (!('settingsSchemaVersion' in request.resource.data)
        || request.resource.data.settingsSchemaVersion is int)
      && request.resource.data.isProfilePrivate is bool
      && request.resource.data.isProfileDiscoverable is bool
      && request.resource.data.showProfileInSuggestions is bool
      && request.resource.data.allowPublicProfilePreview is bool
      && request.resource.data.allowFriendRequests is bool
      && request.resource.data.searchEngineIndexingEnabled is bool
      && (!('phoneNumber' in request.resource.data)
        || isValidOptionalString(request.resource.data.phoneNumber, 40))
      && (!('isPhoneNumberVerified' in request.resource.data)
        || request.resource.data.isPhoneNumberVerified is bool)
      && (!('phoneNumberVerifiedAt' in request.resource.data)
        || isValidNullableTimestamp(request.resource.data.phoneNumberVerifiedAt))
      && (!('phoneNumberUpdatedAt' in request.resource.data)
        || isValidNullableTimestamp(request.resource.data.phoneNumberUpdatedAt))
      && request.resource.data.twoFactorEnabled is bool
      && (!('twoFactorMethod' in request.resource.data)
        || request.resource.data.twoFactorMethod in ['none', 'sms', 'authenticator'])
      && request.resource.data.loginAlertsEnabled is bool
      && request.resource.data.trustedDevicesEnabled is bool
      && request.resource.data.deviceHistoryEnabled is bool
      && request.resource.data.suspiciousLoginProtectionEnabled is bool
      && request.resource.data.sessionRevocationPrepared is bool
      && request.resource.data.remoteLogoutPrepared is bool
      && request.resource.data.securityAuditTrailEnabled is bool
      && (!('backupCodesGenerated' in request.resource.data)
        || request.resource.data.backupCodesGenerated is bool)
      && (!('backupCodesGeneratedAt' in request.resource.data)
        || isValidNullableTimestamp(request.resource.data.backupCodesGeneratedAt))
      && (!('securityDeviceSummary' in request.resource.data)
        || isValidSecurityDeviceSummary(request.resource.data.securityDeviceSummary))
      && (!('securityTimelineSummary' in request.resource.data)
        || isValidSecurityTimelineSummary(request.resource.data.securityTimelineSummary))
      && request.resource.data.pushNotificationsEnabled is bool
      && request.resource.data.inAppNotificationsEnabled is bool
      && request.resource.data.commentNotificationsEnabled is bool
      && request.resource.data.likeNotificationsEnabled is bool
      && request.resource.data.replyNotificationsEnabled is bool
      && request.resource.data.friendRequestNotificationsEnabled is bool
      && request.resource.data.messageNotificationsEnabled is bool
      && request.resource.data.mentionNotificationsEnabled is bool
      && request.resource.data.quietModeEnabled is bool
      && request.resource.data.dailySummaryEnabled is bool
      && request.resource.data.securityNotificationsEnabled is bool
      && request.resource.data.systemUpdateNotificationsEnabled is bool
      && request.resource.data.adminSecurityPriorityNotificationsEnabled is bool
      && request.resource.data.moderationNotificationsEnabled is bool
      && request.resource.data.notificationHistoryEnabled is bool
      && request.resource.data.notificationGroupingEnabled is bool
      && request.resource.data.quietModeAllowSecurityAlerts is bool
      && request.resource.data.notificationPriorityMode in ['calm', 'balanced', 'importantOnly']
      && request.resource.data.digestDeliveryMode in ['off', 'daily', 'importantOnly']
      && request.resource.data.notificationGroupingMode in ['none', 'byType', 'smart']
      && request.resource.data.blockedUsersProtectionEnabled is bool
      && request.resource.data.restrictedInteractionsEnabled is bool
      && request.resource.data.mutedUsersHiddenFromFeed is bool
      && request.resource.data.hideRestrictedUsersComments is bool
      && request.resource.data.appAppearanceMode in ['system', 'dark', 'light']
      && request.resource.data.appAccentPreference in ['lumaOrange', 'warmGold', 'graphite']
      && request.resource.data.appInterfaceDensity in ['comfortable', 'compact']
      && request.resource.data.reduceMotionEnabled is bool
      && request.resource.data.highContrastModeEnabled is bool
      && request.resource.data.useSystemTextScale is bool
      && request.resource.data.showAppearancePreviewCards is bool
      && request.resource.data.contactPermission in ['nobody', 'friendsOnly', 'everyone']
      && request.resource.data.connectionsVisibility in ['onlyMe', 'friendsOnly', 'everyone']
      && request.resource.data.profilePostsVisibility in ['onlyMe', 'friendsOnly', 'friendsOfFriends', 'everyone']
      && request.resource.data.profilePhotosVisibility in ['onlyMe', 'friendsOnly', 'friendsOfFriends', 'everyone']
      && request.resource.data.profileSearchVisibility in ['hidden', 'friendsOnly', 'platform']
      && request.resource.data.profileTaggingPermission in ['nobody', 'friendsOnly', 'everyone']
      && request.resource.data.allowProfileScreenshotWarning is bool
      && request.resource.data.allowProfileForwarding is bool
      && request.resource.data.allowActivityStatusVisibility is bool
      && request.resource.data.allowMutualFriendsPreview is bool
      && request.resource.data.requireApprovalForProfileTags is bool
      && (!('resetAt' in request.resource.data) || request.resource.data.resetAt != null)
      && (!('migratedAt' in request.resource.data) || request.resource.data.migratedAt != null);
    }

    function isValidSecurityDeviceDocument(userId, deviceId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'userId',
        'deviceName',
        'platformLabel',
        'platformType',
        'appContext',
        'trusted',
        'active',
        'firstSeenAt',
        'lastSeenAt',
        'lastLoginAt',
        'disabledAt',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.id == deviceId
      && request.resource.data.userId == userId
      && request.resource.data.deviceName is string
      && request.resource.data.deviceName.size() > 0
      && request.resource.data.deviceName.size() <= 120
      && request.resource.data.platformLabel is string
      && request.resource.data.platformLabel.size() > 0
      && request.resource.data.platformLabel.size() <= 80
      && request.resource.data.platformType in [
        'web',
        'android',
        'ios',
        'macos',
        'windows',
        'linux',
        'fuchsia',
        'unknown'
      ]
      && request.resource.data.appContext in ['web', 'app', 'unknown']
      && request.resource.data.trusted is bool
      && request.resource.data.active is bool
      && isValidNullableTimestamp(request.resource.data.firstSeenAt)
      && isValidNullableTimestamp(request.resource.data.lastSeenAt)
      && isValidNullableTimestamp(request.resource.data.lastLoginAt)
      && isValidNullableTimestamp(request.resource.data.disabledAt);
    }

    function isValidSecurityEventType(type) {
      return type in [
        'successful_login',
        'device_registered',
        'device_trusted',
        'device_deactivated',
        'remote_logout',
        'phone_changed',
        'phone_verified',
        'two_factor_enabled',
        'two_factor_disabled',
        'backup_codes_generated',
        'backup_codes_reset',
        'backup_code_used',
        'password_reset_requested',
        'password_changed',
        'new_location',
        'unknown'
      ];
    }

    function isValidSecurityEventDocument(userId, eventId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'userId',
        'type',
        'severity',
        'title',
        'description',
        'deviceId',
        'deviceName',
        'platformLabel',
        'read',
        'createdAt',
        'readAt',
        'updatedAt'
      ])
      && request.resource.data.id == eventId
      && request.resource.data.userId == userId
      && isValidSecurityEventType(request.resource.data.type)
      && request.resource.data.severity in ['low', 'medium', 'high', 'critical']
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 140
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 700
      && isValidOptionalString(request.resource.data.deviceId, 220)
      && isValidOptionalString(request.resource.data.deviceName, 160)
      && isValidOptionalString(request.resource.data.platformLabel, 100)
      && request.resource.data.read is bool
      && isValidNullableTimestamp(request.resource.data.createdAt)
      && isValidNullableTimestamp(request.resource.data.readAt);
    }

    function isValidSecurityAlertType(type) {
      return type in [
        'new_device',
        'new_location',
        'phone_changed',
        'two_factor_changed',
        'password_changed',
        'remote_logout',
        'backup_codes_changed',
        'unknown'
      ];
    }

    function isValidSecurityAlertDocument(userId, alertId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'userId',
        'type',
        'status',
        'title',
        'body',
        'referenceId',
        'createdAt',
        'readAt',
        'updatedAt'
      ])
      && request.resource.data.id == alertId
      && request.resource.data.userId == userId
      && isValidSecurityAlertType(request.resource.data.type)
      && request.resource.data.status in ['unread', 'read', 'archived']
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 140
      && request.resource.data.body is string
      && request.resource.data.body.size() <= 700
      && isValidOptionalString(request.resource.data.referenceId, 220)
      && isValidNullableTimestamp(request.resource.data.createdAt)
      && isValidNullableTimestamp(request.resource.data.readAt);
    }

    function isValidSecurityAlertUpdate(userId, alertId) {
      return isOwner(userId)
        && resource.data.id == alertId
        && resource.data.userId == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.referenceId == resource.data.referenceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'readAt',
          'updatedAt'
        ])
        && request.resource.data.status in ['unread', 'read', 'archived']
        && isValidNullableTimestamp(request.resource.data.readAt);
    }

    function isValidIncomingFeedPost(postId) {
      let isStandardPost = request.resource.data.postType == 'standard';
      let isRepost = request.resource.data.postType == 'repost';

      return isIncomingPostOwner()
        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'username',
          'userAvatarUrl',
          'contentText',
          'imageUrl',
          'imageStoragePath',
          'feedImageUrl',
          'feedImageStoragePath',
          'videoUrl',
          'videoStoragePath',
          'mood',
          'taggedFriends',
          'locationLabel',
          'createdAt',
          'likeCount',
          'commentCount',
          'postType',
          'visibility',
          'contentCategory',
          'authorType',
          'authorId',
          'shareTarget',
          'originalPostId',
          'originalUsername',
          'originalContentText',
          'originalImageUrl',
          'originalVideoUrl'
        ])
        && request.resource.data.id == postId
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 80
        && isValidOptionalString(request.resource.data.userAvatarUrl, 2048)
        && request.resource.data.contentText is string
        && request.resource.data.contentText.size() <= 420
        && isValidOptionalString(request.resource.data.imageUrl, 4096)
        && isValidOptionalString(request.resource.data.imageStoragePath, 512)
        && isValidOptionalString(request.resource.data.feedImageUrl, 4096)
        && isValidOptionalString(request.resource.data.feedImageStoragePath, 512)
        && isValidOptionalString(request.resource.data.videoUrl, 4096)
        && isValidOptionalString(request.resource.data.videoStoragePath, 512)
        && isValidOptionalString(request.resource.data.mood, 80)
        && request.resource.data.taggedFriends is list
        && request.resource.data.taggedFriends.size() <= 20
        && isValidOptionalString(request.resource.data.locationLabel, 140)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.postType in ['standard', 'repost']
        && request.resource.data.shareTarget in ['feed', 'profile']
        && isValidVisibility(request.resource.data.visibility)
        && request.resource.data.contentCategory in [
          'general',
          'music',
          'photo',
          'video',
          'thought',
          'social'
        ]
        && request.resource.data.authorType in ['user', 'page']
        && isValidOptionalString(request.resource.data.originalPostId, 160)
        && isValidOptionalString(request.resource.data.originalUsername, 80)
        && isValidOptionalString(request.resource.data.originalContentText, 420)
        && isValidOptionalString(request.resource.data.originalImageUrl, 4096)
        && isValidOptionalString(request.resource.data.originalVideoUrl, 4096)
        && (
          (
            isStandardPost
            && request.resource.data.shareTarget == 'feed'
            && (
              request.resource.data.contentText.size() > 0
              || request.resource.data.imageUrl != null
              || request.resource.data.videoUrl != null
            )
          )
          ||
          (
            isRepost
            && request.resource.data.contentText.size() == 0
            && request.resource.data.imageUrl == null
            && request.resource.data.videoUrl == null
            && request.resource.data.originalPostId is string
            && request.resource.data.originalPostId.size() > 0
            && postExists(request.resource.data.originalPostId)
            && request.resource.data.originalUsername is string
            && request.resource.data.originalUsername.size() > 0
            && (
              (
                request.resource.data.originalContentText is string
                && request.resource.data.originalContentText.size() > 0
              )
              || request.resource.data.originalImageUrl != null
              || request.resource.data.originalVideoUrl != null
            )
          )
        );
    }

    function isValidFriendMirrorData(friendId) {
      return request.resource.data.keys().hasOnly([
          'friendUserId',
          'friendshipId',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.friendUserId == friendId
        && request.resource.data.friendshipId is string
        && request.resource.data.status == 'accepted';
    }

    function acceptedFriendshipBacksMirror(userId, friendId) {
      let friendship = getAfter(
        /databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)
      ).data;

      return friendship.status == 'accepted'
        && friendship.participants is list
        && friendship.participants.size() == 2
        && userId in friendship.participants
        && friendId in friendship.participants
        && (
          (
            friendship.requesterUserId == userId
            && friendship.addresseeUserId == friendId
          )
          ||
          (
            friendship.requesterUserId == friendId
            && friendship.addresseeUserId == userId
          )
        );
    }

    function canWriteAcceptedFriendMirror(userId, friendId) {
      return isSignedIn()
        && request.auth.uid in [userId, friendId]
        && isValidFriendMirrorData(friendId)
        && acceptedFriendshipBacksMirror(userId, friendId);
    }

    function canDeleteOwnFriendMirror(userId) {
      return isOwner(userId);
    }

    function canDeleteEndedFriendMirror(userId, friendId) {
      let friendship = getAfter(
        /databases/$(database)/documents/friendships/$(resource.data.friendshipId)
      ).data;

      return isSignedIn()
        && request.auth.uid in [userId, friendId]
        && resource.data.friendUserId == friendId
        && resource.data.friendshipId is string
        && friendship.participants is list
        && friendship.participants.size() == 2
        && userId in friendship.participants
        && friendId in friendship.participants
        && friendship.status in ['declined', 'blocked'];
    }

    function isValidProfileMomentCreate(userId, momentId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'text',
          'moodLabel',
          'moodIconKey',
          'mediaType',
          'mediaUrl',
          'taggedFriendIds',
          'likeCount',
          'commentCount',
          'shareCount',
          'saveCount',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == momentId
        && request.resource.data.userId == userId
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 420
        && (
          request.resource.data.text.size() > 0
          || (
            request.resource.data.mediaUrl is string
            && request.resource.data.mediaUrl.size() > 0
          )
        )
        && isValidOptionalString(request.resource.data.moodLabel, 60)
        && isValidOptionalString(request.resource.data.moodIconKey, 60)
        && request.resource.data.mediaType in ['none', 'image', 'video']
        && isValidOptionalString(request.resource.data.mediaUrl, 4096)
        && request.resource.data.taggedFriendIds is list
        && request.resource.data.taggedFriendIds.size() <= 20
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount >= 0
        && request.resource.data.shareCount is int
        && request.resource.data.shareCount >= 0
        && request.resource.data.saveCount is int
        && request.resource.data.saveCount >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidProfileMomentUpdate(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            isOwner(userId)
            && changedKeys.hasOnly([
              'text',
              'moodLabel',
              'moodIconKey',
              'mediaType',
              'mediaUrl',
              'taggedFriendIds',
              'updatedAt'
            ])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 420
            && (
              request.resource.data.text.size() > 0
              || (
                request.resource.data.mediaUrl is string
                && request.resource.data.mediaUrl.size() > 0
              )
            )
            && isValidOptionalString(request.resource.data.moodLabel, 60)
            && isValidOptionalString(request.resource.data.moodIconKey, 60)
            && request.resource.data.mediaType in ['none', 'image', 'video']
            && isValidOptionalString(request.resource.data.mediaUrl, 4096)
            && request.resource.data.taggedFriendIds is list
            && request.resource.data.taggedFriendIds.size() <= 20
            && request.resource.data.updatedAt is timestamp
          )
          ||
          (
            isSignedIn()
            && changedKeys.hasOnly(['likeCount'])
            && request.resource.data.likeCount is int
            && request.resource.data.likeCount >= 0
          )
          ||
          (
            isSignedIn()
            && changedKeys.hasOnly(['commentCount', 'updatedAt'])
            && request.resource.data.commentCount is int
            && request.resource.data.commentCount >= 0
            && request.resource.data.updatedAt is timestamp
          )
          ||
          (
            isSignedIn()
            && changedKeys.hasOnly(['saveCount', 'updatedAt'])
            && request.resource.data.saveCount is int
            && request.resource.data.saveCount >= 0
            && (
              request.resource.data.saveCount == resource.data.saveCount + 1
              || (
                resource.data.saveCount > 0
                && request.resource.data.saveCount == resource.data.saveCount - 1
              )
            )
            && request.resource.data.updatedAt is timestamp
          )
          ||
          (
            isSignedIn()
            && changedKeys.hasOnly(['shareCount', 'updatedAt'])
            && request.resource.data.shareCount is int
            && request.resource.data.shareCount == resource.data.shareCount + 1
            && request.resource.data.updatedAt is timestamp
          )
        );
    }



    function isValidProfileMomentCommentCreate(userId, momentId, commentId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'momentId',
          'ownerUserId',
          'authorUserId',
          'authorDisplayName',
          'authorUsername',
          'authorAvatarUrl',
          'text',
          'createdAt',
          'updatedAt',
          'editedAt',
          'deletedAt',
          'isDeleted',
          'replyCount'
        ])
        && request.resource.data.id == commentId
        && request.resource.data.momentId == momentId
        && request.resource.data.ownerUserId == userId
        && request.resource.data.authorUserId == request.auth.uid
        && request.resource.data.authorDisplayName is string
        && request.resource.data.authorDisplayName.size() > 0
        && request.resource.data.authorDisplayName.size() <= 90
        && isValidOptionalString(request.resource.data.authorUsername, 60)
        && isValidOptionalString(request.resource.data.authorAvatarUrl, 4096)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && isValidNullableTimestamp(request.resource.data.editedAt)
        && isValidNullableTimestamp(request.resource.data.deletedAt)
        && request.resource.data.isDeleted == false
        && request.resource.data.replyCount == 0;
    }

    function isValidProfileMomentCommentUpdate(userId, momentId, commentId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return isSignedIn()
        && resource.data.id == commentId
        && resource.data.momentId == momentId
        && resource.data.ownerUserId == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.momentId == resource.data.momentId
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.authorUserId == resource.data.authorUserId
        && request.resource.data.authorDisplayName == resource.data.authorDisplayName
        && request.resource.data.authorUsername == resource.data.authorUsername
        && request.resource.data.get('authorAvatarUrl', null) ==
              resource.data.get('authorAvatarUrl', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.replyCount == resource.data.replyCount
        && (
          (
            resource.data.authorUserId == request.auth.uid
            && resource.data.isDeleted == false
            && changedKeys.hasOnly(['text', 'updatedAt', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1200
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.editedAt is timestamp
            && request.resource.data.isDeleted == false
            && request.resource.data.deletedAt == resource.data.deletedAt
          )
          ||
          (
            (resource.data.authorUserId == request.auth.uid || userId == request.auth.uid)
            && resource.data.isDeleted == false
            && changedKeys.hasOnly(['text', 'isDeleted', 'deletedAt', 'updatedAt'])
            && request.resource.data.text == ''
            && request.resource.data.isDeleted == true
            && request.resource.data.deletedAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.editedAt == resource.data.editedAt
          )
        );
    }

    function isValidStoryVisibility(visibility) {
      return visibility in [
        'public',
        'friendsOnly',
        'followersOnly',
        'privateList'
      ];
    }

    function isValidStoryMediaType(mediaType) {
      return mediaType in [
        'image',
        'video'
      ];
    }

    function hasAcceptedFriendMirror(ownerId, viewerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerId)/friends/$(viewerId))
        && get(/databases/$(database)/documents/users/$(ownerId)/friends/$(viewerId)).data.status == 'accepted';
    }

    function canReadFeedPost() {
      return isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.authorId == request.auth.uid
          || resource.data.visibility == 'public'
          || (
            resource.data.visibility == 'friends'
            && (
              hasAcceptedFriendMirror(resource.data.userId, request.auth.uid)
              || hasAcceptedFriendMirror(resource.data.authorId, request.auth.uid)
            )
          )
        );
    }

    function canReadFeedPostById(postId) {
      let post = get(
        /databases/$(database)/documents/feed_posts/$(postId)
      ).data;

      return isSignedIn()
        && (
          post.userId == request.auth.uid
          || post.authorId == request.auth.uid
          || post.visibility == 'public'
          || (
            post.visibility == 'friends'
            && (
              hasAcceptedFriendMirror(post.userId, request.auth.uid)
              || hasAcceptedFriendMirror(post.authorId, request.auth.uid)
            )
          )
        );
    }

    function canReadStory() {
      return isSignedIn()
        && resource.data.isArchived == false
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.visibilityType == 'public'
          || (
            'audienceUserIds' in resource.data
            && resource.data.audienceUserIds is list
            && request.auth.uid in resource.data.audienceUserIds
          )
          || (
            resource.data.visibilityType == 'friendsOnly'
            && !('audienceUserIds' in resource.data)
            && hasAcceptedFriendMirror(resource.data.authorId, request.auth.uid)
          )
        );
    }

    // Query-sichere Variante für Story-Listen.
    // Kein Vergleich mit request.time: Die App filtert aktive Storys bereits
    // über expiresAt in der Query. Ein Client-Zeitstempel kann von Firestore
    // nicht zuverlässig als > request.time bewiesen werden und führte deshalb
    // zu permission-denied bei ansonsten zulässigen Story-Queries.
    function canListStory() {
      return isSignedIn()
        && resource.data.isArchived == false
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.visibilityType == 'public'
          || (
            // Query-sicher für:
            // where('audienceUserIds', arrayContains: request.auth.uid)
            //
            // Bei list-Abfragen muss Firestore die Berechtigung allein aus
            // den Query-Bedingungen beweisen können. arrayContains garantiert
            // bereits, dass die UID in audienceUserIds enthalten ist.
            request.auth.uid in resource.data.audienceUserIds
          )
          || (
            resource.data.visibilityType == 'friendsOnly'
            && !('audienceUserIds' in resource.data)
            && hasAcceptedFriendMirror(resource.data.authorId, request.auth.uid)
          )
        );
    }

    function canPublishAsPage(pageId) {
      let pagePath =
        /databases/$(database)/documents/pages/$(pageId);
      let rolePath =
        /databases/$(database)/documents/pages/$(pageId)/roles/$(request.auth.uid);

      return isSignedIn()
        && pageId is string
        && pageId.size() > 0
        && pageId.size() <= 160
        && exists(pagePath)
        && (
          get(pagePath).data.ownerUserId == request.auth.uid
          || (
            exists(rolePath)
            && get(rolePath).data.role in [
              'owner',
              'admin',
              'editor'
            ]
          )
        );
    }

    function isValidStoryDocument(storyId) {
      return request.resource.data.keys().hasOnly([
        'storyId',
        'authorId',
        'actorType',
        'actorId',
        'createdByUserId',
        'authorName',
        'authorUsername',
        'authorProfileImageUrl',
        'mediaType',
        'mediaUrl',
        'storagePath',
        'thumbnailUrl',
        'caption',
        'createdAt',
        'expiresAt',
        'visibilityType',
        'audienceUserIds',
        'isArchived',
        'archivedAt',
        'viewerCount',
        'likeCount',
        'replyEnabled',
        'isHighlighted'
      ])
      && request.resource.data.storyId is string
      && request.resource.data.storyId == storyId
      && request.resource.data.storyId.size() > 0
      && request.resource.data.storyId.size() <= 120
      && request.resource.data.authorId is string
      && request.resource.data.authorId == request.auth.uid
      && request.resource.data.get('actorType', 'user') in ['user', 'page']
      && request.resource.data.get(
        'actorId',
        request.resource.data.authorId
      ) is string
      && request.resource.data.get(
        'actorId',
        request.resource.data.authorId
      ).size() > 0
      && request.resource.data.get(
        'actorId',
        request.resource.data.authorId
      ).size() <= 160
      && request.resource.data.get(
        'createdByUserId',
        request.resource.data.authorId
      ) is string
      && request.resource.data.get(
        'createdByUserId',
        request.resource.data.authorId
      ) == request.resource.data.authorId
      && (
        (
          request.resource.data.get('actorType', 'user') == 'user'
          && request.resource.data.get(
            'actorId',
            request.resource.data.authorId
          ) == request.resource.data.authorId
        )
        ||
        (
          request.resource.data.get('actorType', 'user') == 'page'
          && request.resource.data.get(
            'actorId',
            request.resource.data.authorId
          ) != request.resource.data.authorId
        )
      )
      && request.resource.data.authorName is string
      && request.resource.data.authorName.size() > 0
      && request.resource.data.authorName.size() <= 80
      && request.resource.data.authorUsername is string
      && request.resource.data.authorUsername.size() > 0
      && request.resource.data.authorUsername.size() <= 40
      && isValidOptionalString(request.resource.data.authorProfileImageUrl, 4096)
      && isValidStoryMediaType(request.resource.data.mediaType)
      && request.resource.data.mediaUrl is string
      && request.resource.data.mediaUrl.size() > 0
      && request.resource.data.mediaUrl.size() <= 4096
      && isValidOptionalString(request.resource.data.storagePath, 512)
      && isValidOptionalString(request.resource.data.thumbnailUrl, 4096)
      && isValidOptionalString(request.resource.data.caption, 280)
      && request.resource.data.createdAt is timestamp
      && request.resource.data.expiresAt is timestamp
      && isValidStoryVisibility(request.resource.data.visibilityType)
      && (
        !('audienceUserIds' in request.resource.data)
        || (
          request.resource.data.audienceUserIds is list
          && request.resource.data.audienceUserIds.size() <= 500
          && (
            request.resource.data.visibilityType != 'public'
            || request.resource.data.audienceUserIds.size() == 0
          )
          && (
            request.resource.data.visibilityType != 'privateList'
            || request.resource.data.audienceUserIds.size() > 0
          )
        )
      )
      && request.resource.data.isArchived is bool
      && (
        !('archivedAt' in request.resource.data)
        || isValidNullableTimestamp(request.resource.data.archivedAt)
      )
      && request.resource.data.viewerCount is int
      && request.resource.data.viewerCount >= 0
      && request.resource.data.likeCount is int
      && request.resource.data.likeCount >= 0
      && request.resource.data.replyEnabled is bool
      && request.resource.data.isHighlighted is bool;
    }

    function isValidStoryCreate(storyId) {
      return isSignedIn()
        && isValidStoryDocument(storyId)
        && request.resource.data.authorId == request.auth.uid
        && 'actorType' in request.resource.data
        && 'actorId' in request.resource.data
        && 'createdByUserId' in request.resource.data
        && request.resource.data.createdByUserId == request.auth.uid
        && (
          (
            request.resource.data.actorType == 'user'
            && request.resource.data.actorId == request.auth.uid
          )
          ||
          (
            request.resource.data.actorType == 'page'
            && canPublishAsPage(request.resource.data.actorId)
            && request.resource.data.visibilityType == 'public'
            && request.resource.data.audienceUserIds.size() == 0
          )
        )
        && 'audienceUserIds' in request.resource.data
        && request.resource.data.visibilityType in [
          'public',
          'friendsOnly',
          'followersOnly',
          'privateList'
        ]
        && request.resource.data.viewerCount == 0
        && request.resource.data.likeCount == 0
        && request.resource.data.isArchived == false
        && request.resource.data.expiresAt > request.resource.data.createdAt;
    }

    function isValidStoryUpdate(storyId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return isSignedIn()
        && resource.data.storyId == storyId
        && request.resource.data.keys().hasOnly([
          'storyId',
          'authorId',
          'actorType',
          'actorId',
          'createdByUserId',
          'authorName',
          'authorUsername',
          'authorProfileImageUrl',
          'mediaType',
          'mediaUrl',
          'storagePath',
          'thumbnailUrl',
          'caption',
          'createdAt',
          'expiresAt',
          'visibilityType',
          'audienceUserIds',
          'isArchived',
          'archivedAt',
          'viewerCount',
          'likeCount',
          'replyEnabled',
          'isHighlighted'
        ])
        && request.resource.data.storyId == resource.data.storyId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.get(
          'actorType',
          'user'
        ) == resource.data.get(
          'actorType',
          'user'
        )
        && request.resource.data.get(
          'actorId',
          request.resource.data.authorId
        ) == resource.data.get(
          'actorId',
          resource.data.authorId
        )
        && request.resource.data.get(
          'createdByUserId',
          request.resource.data.authorId
        ) == resource.data.get(
          'createdByUserId',
          resource.data.authorId
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.mediaType == resource.data.mediaType
        && request.resource.data.mediaUrl == resource.data.mediaUrl
        && request.resource.data.storagePath == resource.data.storagePath
        && (
          request.resource.data.expiresAt == resource.data.expiresAt
          || (
            resource.data.authorId == request.auth.uid
            && resource.data.createdAt is timestamp
            && request.resource.data.expiresAt ==
              resource.data.createdAt + duration.value(24, 'h')
          )
        )
        && request.resource.data.viewerCount is int
        && request.resource.data.viewerCount >= 0
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.isArchived is bool
        && (
          !('archivedAt' in request.resource.data)
          || isValidNullableTimestamp(request.resource.data.archivedAt)
        )
        && (
          (
            resource.data.authorId == request.auth.uid
            && changedKeys.hasOnly([
              'authorName',
              'authorUsername',
              'authorProfileImageUrl',
              'thumbnailUrl',
              'caption',
              'visibilityType',
              'audienceUserIds',
              'isArchived',
              'archivedAt',
              'replyEnabled',
              'isHighlighted'
            ])
            && isValidStoryDocument(storyId)
            && request.resource.data.visibilityType in [
              'public',
              'friendsOnly',
              'followersOnly',
              'privateList'
            ]
          )
          ||
          (
            resource.data.authorId == request.auth.uid
            && changedKeys.hasOnly(['expiresAt'])
            && resource.data.createdAt is timestamp
            && request.resource.data.expiresAt ==
              resource.data.createdAt + duration.value(24, 'h')
            && resource.data.isArchived == false
          )
          ||
          (
            changedKeys.hasOnly(['viewerCount'])
            && resource.data.isArchived == false
            && resource.data.expiresAt is timestamp
            && resource.data.expiresAt > request.time
            && request.resource.data.viewerCount == resource.data.viewerCount + 1
            && request.resource.data.likeCount == resource.data.likeCount
            && request.resource.data.isArchived == resource.data.isArchived
          )
          ||
          (
            changedKeys.hasOnly(['likeCount'])
            && resource.data.isArchived == false
            && resource.data.expiresAt is timestamp
            && resource.data.expiresAt > request.time
            && request.resource.data.likeCount == resource.data.likeCount + 1
            && request.resource.data.viewerCount == resource.data.viewerCount
            && request.resource.data.isArchived == resource.data.isArchived
          )
        );
    }

    function storyExists(storyId) {
      return exists(/databases/$(database)/documents/stories/$(storyId));
    }

    function storyIsActive(storyId) {
      let story = get(/databases/$(database)/documents/stories/$(storyId)).data;

      return story.isArchived == false
        && story.expiresAt is timestamp
        && story.expiresAt > request.time;
    }

    function isValidStoryViewCreate(storyId, viewerId) {
      return isSignedIn()
        && storyExists(storyId)
        && storyIsActive(storyId)
        && viewerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'storyId',
          'viewerId',
          'viewedAt'
        ])
        && request.resource.data.storyId == storyId
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.viewedAt is timestamp;
    }

    function isValidStoryReactionType(type) {
      return type in [
        'heart',
        'fire',
        'laugh',
        'wow'
      ];
    }

    function isValidStoryReactionCreate(storyId, senderId) {
      return isSignedIn()
        && storyExists(storyId)
        && storyIsActive(storyId)
        && senderId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reactionId',
          'storyId',
          'senderId',
          'type',
          'createdAt'
        ])
        && request.resource.data.reactionId == request.auth.uid
        && request.resource.data.storyId == storyId
        && request.resource.data.senderId == request.auth.uid
        && isValidStoryReactionType(request.resource.data.type)
        && request.resource.data.createdAt is timestamp;
    }

    function isValidStoryReactionUpdate(storyId, senderId) {
      return isSignedIn()
        && storyExists(storyId)
        && storyIsActive(storyId)
        && senderId == request.auth.uid
        && resource.data.reactionId == request.auth.uid
        && resource.data.storyId == storyId
        && resource.data.senderId == request.auth.uid
        && request.resource.data.reactionId == resource.data.reactionId
        && request.resource.data.storyId == resource.data.storyId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type',
          'createdAt'
        ])
        && isValidStoryReactionType(request.resource.data.type);
    }

    function isValidStoryReplyCreate(storyId, replyId) {
      return isSignedIn()
        && storyExists(storyId)
        && storyIsActive(storyId)
        && request.resource.data.keys().hasOnly([
          'replyId',
          'storyId',
          'senderId',
          'message',
          'createdAt',
          'deliveredToMessenger'
        ])
        && request.resource.data.replyId == replyId
        && request.resource.data.storyId == storyId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.deliveredToMessenger == false;
    }

    function isValidStoryReplyMessengerDeliveryUpdate(storyId, replyId) {
      return isSignedIn()
        && resource.data.replyId == replyId
        && resource.data.storyId == storyId
        && resource.data.senderId == request.auth.uid
        && resource.data.deliveredToMessenger == false
        && request.resource.data.replyId == resource.data.replyId
        && request.resource.data.storyId == resource.data.storyId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.deliveredToMessenger == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deliveredToMessenger'
        ]);
    }


    function isValidProfileRelationshipStatus(status) {
      return status in [
        'none',
        'pending',
        'accepted',
        'rejected',
        'cancelled',
        'removed',
        'expired'
      ];
    }

    function isValidRomanticStatus(status) {
      return status in [
        'notSpecified',
        'single',
        'inRelationship',
        'engaged',
        'married',
        'civilPartnership',
        'complicated',
        'separated',
        'divorced',
        'widowed'
      ];
    }

    function romanticStatusSupportsPartner(status) {
      return status in [
        'inRelationship',
        'engaged',
        'married',
        'civilPartnership',
        'complicated'
      ];
    }

    function isValidProfileFieldVisibility(value) {
      return value in ['onlyMe', 'friends', 'public'];
    }

    function isValidRelationshipVisibilityMap(data) {
      return data.visibilityByUserId is map
        && data.visibilityByUserId.keys().hasOnly(data.participantUserIds)
        && isValidProfileFieldVisibility(
          data.visibilityByUserId[data.requesterUserId]
        )
        && isValidProfileFieldVisibility(
          data.visibilityByUserId[data.recipientUserId]
        );
    }

    function isRelationshipParticipantData(data) {
      return isSignedIn()
        && data.participantUserIds is list
        && request.auth.uid in data.participantUserIds;
    }

    function isRelationshipParticipant() {
      return isRelationshipParticipantData(resource.data);
    }

    function isIncomingRelationshipParticipant() {
      return isRelationshipParticipantData(request.resource.data);
    }

    function usersAreBlocked(firstUserId, secondUserId) {
      return (
          exists(
            /databases/$(database)/documents/users/$(firstUserId)/blockedUsers/$(secondUserId)
          )
          && get(
            /databases/$(database)/documents/users/$(firstUserId)/blockedUsers/$(secondUserId)
          ).data.isActive == true
        )
        || (
          exists(
            /databases/$(database)/documents/users/$(secondUserId)/blockedUsers/$(firstUserId)
          )
          && get(
            /databases/$(database)/documents/users/$(secondUserId)/blockedUsers/$(firstUserId)
          ).data.isActive == true
        );
    }

    function isValidProfileRelationshipBase(
      relationshipId,
      data
    ) {
      return data.keys().hasOnly([
          'id',
          'requesterUserId',
          'recipientUserId',
          'participantUserIds',
          'romanticStatus',
          'requestStatus',
          'relationshipStartedAt',
          'visibilityByUserId',
          'createdAt',
          'updatedAt',
          'acceptedAt',
          'rejectedAt',
          'cancelledAt',
          'removedAt',
          'expiresAt',
          'removedByUserId',
          'schemaVersion'
        ])
        && data.id == relationshipId
        && data.requesterUserId is string
        && data.requesterUserId.size() > 0
        && data.requesterUserId.size() <= 160
        && data.recipientUserId is string
        && data.recipientUserId.size() > 0
        && data.recipientUserId.size() <= 160
        && data.requesterUserId != data.recipientUserId
        && data.participantUserIds is list
        && data.participantUserIds.size() == 2
        && data.requesterUserId in data.participantUserIds
        && data.recipientUserId in data.participantUserIds
        && isValidRomanticStatus(data.romanticStatus)
        && romanticStatusSupportsPartner(data.romanticStatus)
        && isValidProfileRelationshipStatus(data.requestStatus)
        && isValidNullableTimestamp(data.relationshipStartedAt)
        && isValidRelationshipVisibilityMap(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidNullableTimestamp(data.acceptedAt)
        && isValidNullableTimestamp(data.rejectedAt)
        && isValidNullableTimestamp(data.cancelledAt)
        && isValidNullableTimestamp(data.removedAt)
        && isValidNullableTimestamp(data.expiresAt)
        && isValidOptionalString(data.removedByUserId, 160)
        && data.schemaVersion is int
        && data.schemaVersion >= 1
        && data.schemaVersion <= 20;
    }

    function isValidProfileRelationshipCreate(relationshipId) {
      return isSignedIn()
        && isValidProfileRelationshipBase(
          relationshipId,
          request.resource.data
        )
        && request.resource.data.requesterUserId == request.auth.uid
        && request.resource.data.requestStatus == 'pending'
        && request.resource.data.acceptedAt == null
        && request.resource.data.rejectedAt == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.removedAt == null
        && request.resource.data.removedByUserId == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && !usersAreBlocked(
          request.resource.data.requesterUserId,
          request.resource.data.recipientUserId
        );
    }

    function relationshipParticipantsStayImmutable() {
      return request.resource.data.participantUserIds ==
          resource.data.participantUserIds;
    }

    function isRelationshipVisibilityOnlyUpdate() {
      let changedKeys =
        request.resource.data.diff(resource.data).affectedKeys();

      return changedKeys.hasOnly([
          'visibilityByUserId',
          'updatedAt'
        ])
        && request.resource.data.requestStatus ==
          resource.data.requestStatus
        && request.resource.data.visibilityByUserId[
          request.auth.uid
        ] != resource.data.visibilityByUserId[
          request.auth.uid
        ]
        && request.resource.data.visibilityByUserId[
          resource.data.requesterUserId
        ] == (
          request.auth.uid == resource.data.requesterUserId
            ? request.resource.data.visibilityByUserId[
                resource.data.requesterUserId
              ]
            : resource.data.visibilityByUserId[
                resource.data.requesterUserId
              ]
        )
        && request.resource.data.visibilityByUserId[
          resource.data.recipientUserId
        ] == (
          request.auth.uid == resource.data.recipientUserId
            ? request.resource.data.visibilityByUserId[
                resource.data.recipientUserId
              ]
            : resource.data.visibilityByUserId[
                resource.data.recipientUserId
              ]
        );
    }

    function isRelationshipAcceptUpdate() {
      return resource.data.requestStatus == 'pending'
        && request.resource.data.requestStatus == 'accepted'
        && request.auth.uid == resource.data.recipientUserId
        && request.resource.data.acceptedAt is timestamp
        && request.resource.data.rejectedAt == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.removedAt == null
        && request.resource.data.removedByUserId == null;
    }

    function isRelationshipRejectUpdate() {
      return resource.data.requestStatus == 'pending'
        && request.resource.data.requestStatus == 'rejected'
        && request.auth.uid == resource.data.recipientUserId
        && request.resource.data.rejectedAt is timestamp;
    }

    function isRelationshipCancelUpdate() {
      return resource.data.requestStatus == 'pending'
        && request.resource.data.requestStatus == 'cancelled'
        && request.auth.uid == resource.data.requesterUserId
        && request.resource.data.cancelledAt is timestamp;
    }

    function isRelationshipRemoveUpdate() {
      return resource.data.requestStatus == 'accepted'
        && request.resource.data.requestStatus == 'removed'
        && request.auth.uid in resource.data.participantUserIds
        && request.resource.data.removedAt is timestamp
        && request.resource.data.removedByUserId == request.auth.uid;
    }

    function isRelationshipChangeRequest() {
      return resource.data.requestStatus == 'accepted'
        && request.resource.data.requestStatus == 'pending'
        && request.auth.uid in resource.data.participantUserIds
        && request.resource.data.requesterUserId == request.auth.uid
        && request.resource.data.recipientUserId != request.auth.uid
        && request.resource.data.acceptedAt == null
        && request.resource.data.rejectedAt == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.removedAt == null
        && request.resource.data.removedByUserId == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
    }

    function isValidProfileRelationshipUpdate(relationshipId) {
      return isSignedIn()
        && isRelationshipParticipant()
        && isIncomingRelationshipParticipant()
        && relationshipParticipantsStayImmutable()
        && request.resource.data.createdAt ==
          resource.data.createdAt
        && isValidProfileRelationshipBase(
          relationshipId,
          request.resource.data
        )
        && !usersAreBlocked(
          request.resource.data.requesterUserId,
          request.resource.data.recipientUserId
        )
        && (
          isRelationshipVisibilityOnlyUpdate()
          || isRelationshipAcceptUpdate()
          || isRelationshipRejectUpdate()
          || isRelationshipCancelUpdate()
          || isRelationshipRemoveUpdate()
          || isRelationshipChangeRequest()
        );
    }

    function relationshipIdForMirror(userId) {
      return request.resource.data.get(
          'romanticRelationshipId',
          null
        ) != null
        ? request.resource.data.romanticRelationshipId
        : resource.data.get('romanticRelationshipId', '');
    }

    function isValidRelationshipMirrorUpdate(userId) {
      let changedKeys =
        request.resource.data.diff(resource.data).affectedKeys();
      let relationshipId = relationshipIdForMirror(userId);
      let relationship = getAfter(
        /databases/$(database)/documents/profile_relationships/$(relationshipId)
      ).data;
      let isParticipant =
        relationship.participantUserIds is list
        && userId in relationship.participantUserIds
        && request.auth.uid in relationship.participantUserIds;
      let otherUserId = relationship.requesterUserId == userId
        ? relationship.recipientUserId
        : relationship.requesterUserId;

      return isSignedIn()
        && relationshipId is string
        && relationshipId.size() > 0
        && isParticipant
        && changedKeys.hasOnly([
          'romanticStatus',
          'romanticRelationshipId',
          'romanticPartnerUserId',
          'romanticPartnerDisplayName',
          'romanticPartnerUsername',
          'romanticPartnerAvatarUrl',
          'romanticRelationshipRequestStatus',
          'romanticRelationshipStartedAt',
          'romanticRelationshipVisibility',
          'updatedAt'
        ])
        && request.resource.data.updatedAt != null
        && (
          (
            relationship.requestStatus == 'accepted'
            && request.resource.data.romanticRelationshipId ==
              relationshipId
            && request.resource.data.romanticStatus ==
              relationship.romanticStatus
            && request.resource.data.romanticPartnerUserId ==
              otherUserId
            && request.resource.data.romanticRelationshipRequestStatus ==
              'accepted'
            && request.resource.data.romanticRelationshipVisibility ==
              relationship.visibilityByUserId[userId]
          )
          ||
          (
            relationship.requestStatus == 'pending'
            && request.resource.data.romanticRelationshipRequestStatus ==
              'pending'
          )
          ||
          (
            relationship.requestStatus == 'removed'
            && request.resource.data.romanticRelationshipId == null
            && request.resource.data.romanticPartnerUserId == null
            && request.resource.data.romanticPartnerDisplayName == null
            && request.resource.data.romanticPartnerUsername == null
            && request.resource.data.romanticPartnerAvatarUrl == null
            && request.resource.data.romanticRelationshipRequestStatus ==
              'removed'
            && request.resource.data.romanticRelationshipStartedAt == null
          )
        );
    }

    match /users/{userId} {
      function isValidVerificationProfileUpdate() {
        let changedKeys =
          request.resource.data.diff(resource.data).affectedKeys();

        return isVerificationAdmin()
          && changedKeys.hasOnly([
            'isVerified',
            'verificationState',
            'verificationApprovedAt',
            'verificationReviewedBy',
            'verificationReviewerDisplayName',
            'updatedAt'
          ])
          && request.resource.data.get('isVerified', false) is bool
          && request.resource.data.get('verificationState', 'none') in [
            'none',
            'greyVerified',
            'blueVerified',
            'revoked'
          ]
          && isValidNullableTimestamp(
            request.resource.data.get('verificationApprovedAt', null)
          )
          && isValidOptionalString(
            request.resource.data.get('verificationReviewedBy', null),
            220
          )
          && isValidOptionalString(
            request.resource.data.get(
              'verificationReviewerDisplayName',
              null
            ),
            180
          )
          && request.resource.data.get('updatedAt', null) != null
          && (
            (
              request.resource.data.get('isVerified', false) == true
              && request.resource.data.get('verificationState', 'none') in [
                'greyVerified',
                'blueVerified'
              ]
              && request.resource.data.get(
                'verificationApprovedAt',
                null
              ) is timestamp
            )
            ||
            (
              request.resource.data.get('isVerified', false) == false
              && request.resource.data.get('verificationState', 'none') in [
                'none',
                'revoked'
              ]
              && request.resource.data.get(
                'verificationApprovedAt',
                null
              ) == null
            )
          );
      }

      match /followers/{followerUserId} {
        allow read: if isSignedIn()
          && (
            request.auth.uid == userId
            || request.auth.uid == followerUserId
          );

        allow create: if isSignedIn()
          && request.auth.uid == followerUserId
          && followerUserId != userId
          && request.resource.data.keys().hasOnly([
            'followerUserId',
            'targetUserId',
            'createdAt'
          ])
          && request.resource.data.followerUserId == followerUserId
          && request.resource.data.targetUserId == userId
          && request.resource.data.createdAt != null;

        allow update: if false;

        allow delete: if isSignedIn()
          && request.auth.uid == followerUserId;
      }

      match /friends/{friendUserId} {
        allow read: if isSignedIn();

        allow create, update: if isValidFriendMirror(userId, friendUserId);

        allow delete: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == friendUserId);
      }

      match /blockedUsers/{blockedUserId} {
        allow read: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == blockedUserId);

        allow create, update: if isValidBlockedUserWrite(userId, blockedUserId);

        allow delete: if request.auth.uid == userId;
      }



      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || isValidRelationshipMirrorUpdate(userId)
        || isValidVerificationProfileUpdate();
      allow delete: if false;

      // Unveränderbarer Nachweis der bei einer Registrierung
      // bestätigten Luma-Rechtsdokumente.
      //
      // acceptedAt muss der von Firestore aufgelösten Serverzeit entsprechen.
      // Dadurch kann der Client keinen beliebigen Zustimmungszeitpunkt setzen.
      match /legal_consents/{consentId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'userId',
            'termsAccepted',
            'termsVersion',
            'privacyAcknowledged',
            'privacyVersion',
            'acceptedAt',
            'source',
            'context',
            'schemaVersion'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.termsAccepted == true
          && request.resource.data.termsVersion == '2026-08'
          && request.resource.data.privacyAcknowledged == true
          && request.resource.data.privacyVersion == '2026-08'
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.source in ['email', 'google']
          && request.resource.data.context == 'registration'
          && request.resource.data.schemaVersion == 1;

        // Ein einmal gespeicherter Zustimmungsnachweis ist absichtlich
        // weder vom Nutzer noch vom Client nachträglich veränderbar.
        allow update, delete: if false;
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId) && settingId == 'app';

        allow create, update: if isOwner(userId)
          && settingId == 'app'
          && isValidSettingsDocument();

        allow delete: if false;
      }


      match /notification_tokens/{tokenId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'token',
            'userId',
            'platform',
            'isWeb',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in [
            'android',
            'ios',
            'web',
            'windows',
            'macos',
            'linux',
            'unknown'
          ]
          && request.resource.data.isWeb is bool
          && request.resource.data.createdAt != null
          && request.resource.data.updatedAt != null;

        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.token == resource.data.token
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'platform',
            'isWeb',
            'updatedAt'
          ])
          && request.resource.data.platform in [
            'android',
            'ios',
            'web',
            'windows',
            'macos',
            'linux',
            'unknown'
          ]
          && request.resource.data.isWeb is bool
          && request.resource.data.updatedAt != null;

        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);

        allow create: if (
          isSignedIn()
          && request.resource.data.get('actorUserId', '') == request.auth.uid
          && isValidNotificationDocument(userId, notificationId)
        ) || isValidStoryInteractionNotification(userId, notificationId);

        allow update: if isValidNotificationUpdate(userId, notificationId)
          || isValidNotificationActorUpdate(userId, notificationId)
          || isValidStoryInteractionNotification(userId, notificationId);

        allow delete: if isOwner(userId)
          || canDeleteOwnCommentReactionNotification(userId);
      }

      match /friends/{friendId} {
        allow read: if isSignedIn();

        allow create: if canWriteAcceptedFriendMirror(userId, friendId);

        allow update: if canWriteAcceptedFriendMirror(userId, friendId)
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if canDeleteOwnFriendMirror(userId)
          || canDeleteEndedFriendMirror(userId, friendId);
      }

      match /profile_moments/{momentId} {
        allow read: if isSignedIn();

        allow create: if isValidProfileMomentCreate(userId, momentId);

        allow update: if isValidProfileMomentUpdate(userId);

        allow delete: if isOwner(userId)
          && resource.data.userId == userId;

        match /liked_by/{likerUserId} {
          allow read: if isSignedIn();

          allow create: if isOwner(likerUserId)
            && request.resource.data.keys().hasOnly([
              'userId',
              'createdAt'
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt != null;

          allow delete: if isOwner(likerUserId);
          allow update: if false;
        }

        match /saved_by/{saverUserId} {
          allow read: if isSignedIn()
            && (
              isOwner(saverUserId)
              || isOwner(userId)
            );

          allow create: if isOwner(saverUserId)
            && request.resource.data.keys().hasOnly([
              'userId',
              'ownerUserId',
              'momentId',
              'createdAt'
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.ownerUserId == userId
            && request.resource.data.momentId == momentId
            && request.resource.data.createdAt != null;

          allow delete: if isOwner(saverUserId);
          allow update: if false;
        }

        match /shared_by/{shareId} {
          allow read: if isSignedIn()
            && (
              isOwner(userId)
              || resource.data.userId == request.auth.uid
            );

          allow create: if isSignedIn()
            && request.resource.data.keys().hasOnly([
              'id',
              'userId',
              'ownerUserId',
              'momentId',
              'channel',
              'createdAt'
            ])
            && request.resource.data.id == shareId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.ownerUserId == userId
            && request.resource.data.momentId == momentId
            && request.resource.data.channel in [
              'messenger',
              'link',
              'external',
              'feed',
              'profile'
            ]
            && request.resource.data.createdAt != null;

          allow update, delete: if false;
        }

        match /comments/{commentId} {
          allow read: if isSignedIn();

          allow create: if isValidProfileMomentCommentCreate(
            userId,
            momentId,
            commentId
          );

          allow update: if isValidProfileMomentCommentUpdate(
            userId,
            momentId,
            commentId
          );

          allow delete: if false;
        }
      }

      match /profile_photos/{photoId} {
        allow read: if isSignedIn();

        allow create, update: if isOwner(userId);

        allow delete: if isOwner(userId);
      }

      match /profilePhotos/{photoId} {
        allow read: if isSignedIn();

        allow create, update: if isOwner(userId);

        allow delete: if isOwner(userId);
      }

      match /photos/{photoId} {
        allow read: if isSignedIn();

        allow create, update: if isOwner(userId);

        allow delete: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && isValidSecurityDeviceDocument(userId, deviceId);

        allow delete: if false;
      }

      match /security_events/{eventId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidSecurityEventDocument(userId, eventId);

        allow update: if isOwner(userId)
          && resource.data.id == eventId
          && resource.data.userId == userId
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.type == resource.data.type
          && request.resource.data.severity == resource.data.severity
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.deviceName == resource.data.deviceName
          && request.resource.data.platformLabel == resource.data.platformLabel
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read',
            'readAt',
            'updatedAt'
          ])
          && request.resource.data.read is bool
          && isValidNullableTimestamp(request.resource.data.readAt);

        allow delete: if false;
      }

      match /security_alerts/{alertId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidSecurityAlertDocument(userId, alertId);

        allow update: if isValidSecurityAlertUpdate(userId, alertId);

        allow delete: if false;
      }

      match /security/{securityDoc} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;

        match /codes/{codeId} {
          allow read: if isOwner(userId);
          allow create, update, delete: if false;
        }
      }
    }

    match /messenger_presence/{userId} {
      allow read: if isSignedIn();
      allow create: if isValidMessengerPresenceDocument(userId);
      allow update: if isValidMessengerPresenceUpdate(userId);
      allow delete: if false;
    }


    match /conversations/{conversationId} {
      allow get: if isConversationLookupAllowed(conversationId);

      allow list: if isSafeConversationListQuery();

      allow create: if isValidConversationCreate();
      allow update: if isValidConversationUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipantOfConversation(conversationId);
        allow create: if isValidMessageCreate(conversationId);
        allow update: if isValidMessageUpdate(conversationId);
        allow delete: if false;
      }


      match /activity/{activityUserId} {
        allow read: if isParticipantOfConversation(conversationId);
        allow create: if isValidConversationActivityCreate(
          conversationId,
          activityUserId
        );
        allow update: if isValidConversationActivityUpdate(
          conversationId,
          activityUserId
        );
        allow delete: if false;
      }
    }


    match /calls/{callId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid in resource.data.participantIds
          || request.auth.uid == resource.data.callerUserId
          || request.auth.uid == resource.data.receiverUserId
        );

      allow create: if isValidCallCreate();

      allow update: if isValidCallUpdate();

      allow delete: if false;
    }


    match /profile_relationships/{relationshipId} {
      allow read: if isRelationshipParticipant();

      allow create: if isValidProfileRelationshipCreate(
        relationshipId
      );

      allow update: if isValidProfileRelationshipUpdate(
        relationshipId
      );

      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      // Einzelne Freundschaftsdokumente dürfen weiterhin nur von
      // Beteiligten gelesen werden.
      allow get: if isFriendshipParticipant();

      // Collection-Queries auf Freundschaften sind für angemeldete Nutzer
      // erlaubt. Die App grenzt die Abfrage weiterhin über
      // participants + arrayContains auf den aktuellen Nutzer ein.
      //
      // Wichtig: Diese Regel behebt den aktuellen permission-denied-Fehler
      // bei Friendship-Queries. Für eine spätere zusätzliche Härtung sollte
      // die Friendship-Architektur weiter serverseitig abgesichert werden.
      allow list: if isSignedIn();

      allow create: if isValidFriendshipCreate();

      allow update: if isValidFriendshipUpdate();

      allow delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && resource.data.blockerUserId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'blockerUserId',
          'blockedUserId',
          'createdAt'
        ])
        && request.resource.data.id == blockId
        && request.resource.data.blockerUserId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.blockerUserId == request.auth.uid;

      allow update: if false;
    }

    match /stories/{storyId} {
      allow get: if canReadStory();

      allow list: if canListStory()
        && request.query.limit <= 100;

      allow create: if isValidStoryCreate(storyId);

      allow update: if isValidStoryUpdate(storyId);

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /views/{viewerId} {
        allow read: if isSignedIn();

        allow create: if isValidStoryViewCreate(storyId, viewerId);

        allow update: if false;

        allow delete: if false;
      }

      match /reactions/{senderId} {
        allow read: if isSignedIn();

        allow create: if isValidStoryReactionCreate(storyId, senderId);

        allow update: if isValidStoryReactionUpdate(storyId, senderId);

        allow delete: if isSignedIn()
          && senderId == request.auth.uid;
      }

      match /replies/{replyId} {
        allow read: if isSignedIn();

        allow create: if isValidStoryReplyCreate(storyId, replyId);

        allow update: if isValidStoryReplyMessengerDeliveryUpdate(
          storyId,
          replyId
        );

        allow delete: if false;
      }
    }

    match /{path=**}/views/{viewerId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/reactions/{senderId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/replies/{replyId} {
      allow read: if isSignedIn();
    }

    // Collection-Group-Lookups für persönliche Feed-Marker.
    //
    // WICHTIG:
    // Die App fragt liked_by und saved_by über collectionGroup() anhand
    // des Feldes userId ab. Eine reine Prüfung der Dokument-ID reicht für
    // solche Queries nicht aus, weil Firestore vor der Ausführung beweisen
    // muss, dass jedes mögliche Ergebnis zum angemeldeten Nutzer gehört.
    //
    // get:
    // Unterstützt sowohl die aktuelle Dokument-ID-Struktur als auch ältere
    // Marker, bei denen die UID zusätzlich bzw. ausschließlich im Feld
    // userId gespeichert wurde.
    //
    // list:
    // Erlaubt ausschließlich Queries, deren zurückgegebene Dokumente das
    // eigene userId-Feld besitzen. Die Abfrage muss deshalb weiterhin mit
    // where('userId', isEqualTo: currentUser.uid) ausgeführt werden.
    match /{path=**}/liked_by/{markerUserId} {
      allow get: if isSignedIn()
        && (
          markerUserId == request.auth.uid
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/saved_by/{markerUserId} {
      allow get: if isSignedIn()
        && (
          markerUserId == request.auth.uid
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /feed_posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isValidIncomingFeedPost(postId);

      allow update: if isSignedIn()
        && (
          (
            isPostOwner()
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'username',
              'userAvatarUrl',
              'contentText',
              'imageUrl',
              'imageStoragePath',
              'feedImageUrl',
              'feedImageStoragePath',
              'videoUrl',
              'videoStoragePath',
              'mood',
              'taggedFriends',
              'locationLabel',
              'visibility',
              'contentCategory',
              'likeCount',
              'commentCount',
              'updatedAt'
            ])
            && request.resource.data.contentText is string
            && request.resource.data.contentText.size() <= 420
            && isValidOptionalString(request.resource.data.imageUrl, 4096)
            && isValidOptionalString(request.resource.data.imageStoragePath, 512)
            && isValidOptionalString(request.resource.data.feedImageUrl, 4096)
            && isValidOptionalString(request.resource.data.feedImageStoragePath, 512)
            && isValidOptionalString(request.resource.data.videoUrl, 4096)
            && isValidOptionalString(request.resource.data.videoStoragePath, 512)
            && isValidOptionalString(request.resource.data.mood, 80)
            && request.resource.data.taggedFriends is list
            && request.resource.data.taggedFriends.size() <= 20
            && isValidOptionalString(request.resource.data.locationLabel, 140)
            && isValidVisibility(request.resource.data.visibility)
            && request.resource.data.contentCategory in [
              'general',
              'music',
              'photo',
              'video',
              'thought',
              'social'
            ]
            && request.resource.data.likeCount is int
            && request.resource.data.likeCount >= 0
            && request.resource.data.commentCount is int
            && request.resource.data.commentCount >= 0
          )
          ||
(
  request.resource.data.userId == resource.data.userId
  && request.resource.data.authorId == resource.data.authorId
  && request.resource.data.createdAt == resource.data.createdAt
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
    'likeCount',
    'commentCount',
    'updatedAt'
  ])
  && (
    !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(['updatedAt'])
    || request.resource.data.updatedAt is timestamp
  )
  && request.resource.data.likeCount is int
  && request.resource.data.likeCount >= 0
  && request.resource.data.commentCount is int
  && request.resource.data.commentCount >= 0
)
        );

      allow delete: if isPostOwner();

      match /liked_by/{reactionMarkerId} {
        allow read: if isSignedIn();

        // Persönliche Reaktionen bleiben vollständig rückwärtskompatibel:
        // Dokument-ID = Firebase UID und bestehendes 5-Felder-Schema.
        allow create: if (
          reactionMarkerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'userId',
            'postId',
            'reactionType',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.postId == postId
          && isValidFeedReactionType(request.resource.data.reactionType)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
        )
        ||
        (
          // Page-Reaktion:
          // Firebase UID bleibt der handelnde Operator; actorId ist die Page.
          reactionMarkerId ==
            'page_' + request.resource.data.get('actorId', '')
          && request.resource.data.keys().hasOnly([
            'userId',
            'postId',
            'reactionType',
            'createdAt',
            'updatedAt',
            'actorType',
            'actorId',
            'createdByUserId',
            'actorDisplayName',
            'actorUsername',
            'actorAvatarUrl'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.actorType == 'page'
          && request.resource.data.actorId is string
          && request.resource.data.actorId.size() > 0
          && request.resource.data.actorId.size() <= 160
          && canPublishAsPage(request.resource.data.actorId)
          && request.resource.data.actorDisplayName is string
          && request.resource.data.actorDisplayName.size() <= 120
          && request.resource.data.actorUsername is string
          && request.resource.data.actorUsername.size() <= 80
          && request.resource.data.actorAvatarUrl is string
          && request.resource.data.actorAvatarUrl.size() <= 4096
          && request.resource.data.postId == postId
          && isValidFeedReactionType(request.resource.data.reactionType)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
        );

        allow update: if (
          reactionMarkerId == request.auth.uid
          && resource.data.get('actorType', 'user') != 'page'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.postId == postId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reactionType',
            'updatedAt'
          ])
          && isValidFeedReactionType(request.resource.data.reactionType)
          && request.resource.data.updatedAt is timestamp
        )
        ||
        (
          resource.data.get('actorType', '') == 'page'
          && resource.data.get('createdByUserId', '') == request.auth.uid
          && canPublishAsPage(resource.data.get('actorId', ''))
          && reactionMarkerId ==
            'page_' + resource.data.get('actorId', '')
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.actorType == resource.data.actorType
          && request.resource.data.actorId == resource.data.actorId
          && request.resource.data.createdByUserId ==
            resource.data.createdByUserId
          && request.resource.data.actorDisplayName ==
            resource.data.actorDisplayName
          && request.resource.data.actorUsername ==
            resource.data.actorUsername
          && request.resource.data.actorAvatarUrl ==
            resource.data.actorAvatarUrl
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reactionType',
            'updatedAt'
          ])
          && isValidFeedReactionType(request.resource.data.reactionType)
          && request.resource.data.updatedAt is timestamp
        );

        allow delete: if (
          reactionMarkerId == request.auth.uid
          && resource.data.get('actorType', 'user') != 'page'
        )
        ||
        (
          resource.data.get('actorType', '') == 'page'
          && resource.data.get('createdByUserId', '') == request.auth.uid
          && canPublishAsPage(resource.data.get('actorId', ''))
          && reactionMarkerId ==
            'page_' + resource.data.get('actorId', '')
        );
      }

      match /saved_by/{userId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'userId',
            'postId',
            'createdAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.createdAt != null;

        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if postExists(postId) && canReadFeedPostById(postId);

        allow create: if isSignedIn()
          && postExists(postId)
          && canReadFeedPostById(postId)
          && request.resource.data.keys().hasOnly([
            'id',
            'postId',
            'authorId',
            'authorName',
            'authorAvatarUrl',
            'text',
            'createdAt',
            'updatedAt',
            'deletedAt',
            'parentCommentId',
            'likeCount',
            'reactionCount',
            'reactionCounts',
            'replyCount',
            'isDeleted',
            'schemaVersion'
          ])
          && request.resource.data.id == commentId
          && request.resource.data.postId == postId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 120
          && isValidOptionalString(
            request.resource.data.authorAvatarUrl,
            4096
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is timestamp
          && isValidNullableTimestamp(
            request.resource.data.get('updatedAt', null)
          )
          && isValidNullableTimestamp(
            request.resource.data.get('deletedAt', null)
          )
          && (
            request.resource.data.parentCommentId == null
            || (
              request.resource.data.parentCommentId is string
              && request.resource.data.parentCommentId.size() > 0
              && request.resource.data.parentCommentId.size() <= 220
            )
          )
          && request.resource.data.likeCount == 0
          && request.resource.data.reactionCount == 0
          && isValidCommentReactionCounts(
            request.resource.data.reactionCounts,
            request.resource.data.reactionCount
          )
          && request.resource.data.replyCount == 0
          && request.resource.data.isDeleted == false
          && request.resource.data.schemaVersion == 2;

        allow update: if isSignedIn()
          && postExists(postId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.get('authorAvatarUrl', null) ==
              resource.data.get('authorAvatarUrl', null)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('parentCommentId', null) ==
              resource.data.get('parentCommentId', null)
          && request.resource.data.get('schemaVersion', 1) ==
              resource.data.get('schemaVersion', 1)
          && (
            (
              resource.data.authorId == request.auth.uid
              && resource.data.isDeleted == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text',
                'updatedAt'
              ])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 500
              && request.resource.data.updatedAt is timestamp
            )
            ||
            (
              (
                resource.data.authorId == request.auth.uid
                || isCommentThreadOwner(
                  postId,
                  resource.data.get('parentCommentId', '')
                )
              )
              && resource.data.isDeleted == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text',
                'isDeleted',
                'deletedAt',
                'updatedAt',
                'likeCount',
                'reactionCount',
                'reactionCounts',
                'replyCount'
              ])
              && request.resource.data.text == ''
              && request.resource.data.isDeleted == true
              && request.resource.data.deletedAt is timestamp
              && request.resource.data.updatedAt is timestamp
              && request.resource.data.likeCount == 0
              && request.resource.data.reactionCount == 0
              && isValidCommentReactionCounts(
                request.resource.data.reactionCounts,
                request.resource.data.reactionCount
              )
              && request.resource.data.replyCount is int
              && request.resource.data.replyCount >= 0
            )
            ||
            (
              resource.data.isDeleted == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'likeCount',
                'reactionCount',
                'reactionCounts',
                'updatedAt'
              ])
              && request.resource.data.updatedAt is timestamp
              && request.resource.data.likeCount ==
                  request.resource.data.reactionCount
              && isValidCommentReactionCounts(
                request.resource.data.reactionCounts,
                request.resource.data.reactionCount
              )
              && (
                request.resource.data.reactionCount ==
                    resource.data.get('reactionCount', resource.data.likeCount) + 1
                || (
                  resource.data.get('reactionCount', resource.data.likeCount) > 0
                  && request.resource.data.reactionCount ==
                      resource.data.get('reactionCount', resource.data.likeCount) - 1
                )
                || request.resource.data.reactionCount ==
                    resource.data.get('reactionCount', resource.data.likeCount)
              )
            )
            ||
            (
              resource.data.isDeleted == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'replyCount',
                'updatedAt'
              ])
              && (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                  'updatedAt'
                ])
                || request.resource.data.updatedAt is timestamp
              )
              && request.resource.data.replyCount is int
              && request.resource.data.replyCount >= 0
              && (
                request.resource.data.replyCount == resource.data.replyCount + 1
                || (
                  resource.data.replyCount > 0
                  && request.resource.data.replyCount == resource.data.replyCount - 1
                )
                || request.resource.data.replyCount == 0
              )
            )
          );

        allow delete: if false;

        match /liked_by/{userId} {
          allow read: if isSignedIn();

          allow create: if isOwner(userId)
            && postExists(postId)
            && canReadFeedPostById(postId)
            && request.resource.data.keys().hasOnly([
              'userId',
              'postId',
              'commentId',
              'reactionType',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.postId == postId
            && request.resource.data.commentId == commentId
            && isValidFeedReactionType(
              request.resource.data.reactionType
            )
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;

          allow update: if isOwner(userId)
            && postExists(postId)
            && canReadFeedPostById(postId)
            && request.resource.data.keys().hasOnly([
              'userId',
              'postId',
              'commentId',
              'reactionType',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.postId == postId
            && request.resource.data.postId == resource.data.postId
            && request.resource.data.commentId == commentId
            && request.resource.data.commentId == resource.data.commentId
            && request.resource.data.get('createdAt', null) ==
              resource.data.get('createdAt', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reactionType',
              'updatedAt'
            ])
            && isValidFeedReactionType(
              request.resource.data.reactionType
            )
            && request.resource.data.updatedAt is timestamp;

          allow delete: if isOwner(userId)
            && resource.data.userId == request.auth.uid
            && resource.data.postId == postId
            && resource.data.commentId == commentId;
        }
      }
    }


    match /messenger_blocks/{blockId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'conversationId',
          'blockerUserId',
          'blockedUserId',
          'participantIds',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() > 0
        && request.resource.data.conversationId.size() <= 220
        && request.resource.data.blockerUserId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId.size() > 0
        && request.resource.data.blockedUserId != request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.blockedUserId in request.resource.data.participantIds
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt != null
        && request.resource.data.updatedAt != null
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.participantIds
        && request.resource.data.blockedUserId in get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.participantIds;

      allow update: if isSignedIn()
        && resource.data.blockerUserId == request.auth.uid
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.blockerUserId == resource.data.blockerUserId
        && request.resource.data.blockedUserId == resource.data.blockedUserId
        && request.resource.data.participantIds == resource.data.participantIds
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt != null;

      allow delete: if false;
    }

    match /message_reports/{reportId} {
      allow read: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'conversationId',
          'messageId',
          'reporterUserId',
          'reportedUserId',
          'reason',
          'messageType',
          'messagePreview',
          'messageCreatedAt',
          'reportedAt',
          'updatedAt',
          'status',
          'source'
        ])
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() > 0
        && request.resource.data.conversationId.size() <= 220
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() > 0
        && request.resource.data.messageId.size() <= 220
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId.size() > 0
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && request.resource.data.messageType in ['text', 'image', 'audio', 'file']
        && request.resource.data.messagePreview is string
        && request.resource.data.messagePreview.size() <= 500
        && request.resource.data.messageCreatedAt != null
        && request.resource.data.reportedAt != null
        && request.resource.data.updatedAt != null
        && request.resource.data.status == 'open'
        && request.resource.data.source == 'messenger'
        && isParticipantOfConversation(request.resource.data.conversationId);

      allow update: if isSignedIn()
        && resource.data.reporterUserId == request.auth.uid
        && request.resource.data.reporterUserId == resource.data.reporterUserId
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.messageId == resource.data.messageId
        && request.resource.data.reportedUserId == resource.data.reportedUserId
        && request.resource.data.messageType == resource.data.messageType
        && request.resource.data.messagePreview == resource.data.messagePreview
        && request.resource.data.messageCreatedAt == resource.data.messageCreatedAt
        && request.resource.data.reportedAt == resource.data.reportedAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.source == resource.data.source
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reason',
          'duplicateReportedAt',
          'updatedAt'
        ])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && request.resource.data.updatedAt != null;

      allow delete: if false;
    }


    // ---------------------------------------------------------------------
    // Zentrale Meldungen
    // ---------------------------------------------------------------------

    match /reports/{reportId} {
      function isValidReportTargetType(value) {
        return value in [
          'post',
          'profile',
          'comment',
          'message',
          'page'
        ];
      }

      function isValidReportReason(value) {
        return value in [
          'spam',
          'harassment',
          'hateSpeech',
          'impersonation',
          'scam',
          'inappropriateContent',
          'violence',
          'selfHarm',
          'childSafety',
          'intellectualProperty',
          'other'
        ];
      }

      function isValidReportStatus(value) {
        return value in [
          'open',
          'underReview',
          'resolved',
          'rejected'
        ];
      }

      function isValidReportCreate() {
        return isSignedIn()
          && request.resource.data.keys().hasOnly([
            'id',
            'reporterId',
            'targetId',
            'targetType',
            'reason',
            'additionalText',
            'createdAt',
            'updatedAt',
            'status',
            'source'
          ])
          && request.resource.data.id == reportId
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.targetId is string
          && request.resource.data.targetId.size() > 0
          && request.resource.data.targetId.size() <= 220
          && isValidReportTargetType(
            request.resource.data.targetType
          )
          && isValidReportReason(
            request.resource.data.reason
          )
          && (
            request.resource.data.additionalText == null
            ||
            (
              request.resource.data.additionalText is string
              && request.resource.data.additionalText.size() <= 1000
            )
          )
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.status == 'open'
          && request.resource.data.source is string
          && request.resource.data.source.size() > 0
          && request.resource.data.source.size() <= 80;
      }

      function isValidReporterUpdate() {
        let changedKeys =
          request.resource.data.diff(resource.data).affectedKeys();

        return isSignedIn()
          && resource.data.reporterId == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.reporterId == resource.data.reporterId
          && request.resource.data.targetId == resource.data.targetId
          && request.resource.data.targetType == resource.data.targetType
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status == resource.data.status
          && request.resource.data.source == resource.data.source
          && changedKeys.hasOnly([
            'reason',
            'additionalText',
            'updatedAt',
            'duplicateReportedAt'
          ])
          && isValidReportReason(
            request.resource.data.reason
          )
          && (
            request.resource.data.additionalText == null
            ||
            (
              request.resource.data.additionalText is string
              && request.resource.data.additionalText.size() <= 1000
            )
          )
          && request.resource.data.updatedAt is timestamp
          && (
            !('duplicateReportedAt' in request.resource.data)
            || request.resource.data.duplicateReportedAt is timestamp
          );
      }

      allow create: if isValidReportCreate();

      allow read: if isSignedIn()
        && resource.data.reporterId == request.auth.uid;

      allow update: if isValidReporterUpdate();

      allow delete: if false;
    }

    match /app_config/{documentId} {
      allow read: if documentId == 'version';
      allow write: if false;
    }


match /users/{userId}/remembered_login_credentials/{credentialId} {
  allow read, write: if false;
}


    // ---------------------------------------------------------------------
    // Luma Pages
    // ---------------------------------------------------------------------
    match /media/{mediaId} {

      allow read: if true;

      allow create: if canManageCurrentPage();

      allow update: if canManageCurrentPage();

      allow delete: if canManageCurrentPage();
    }
    match /pages/{pageId} {
      function pageDocumentPath() {
        return /databases/$(database)/documents/pages/$(pageId);
      }

      function currentPageOwnerId() {
        return resource.data.ownerUserId;
      }

      function incomingPageOwnerId() {
        return request.resource.data.ownerUserId;
      }

      function pageRolePath(userId) {
        return /databases/$(database)/documents/pages/$(pageId)/roles/$(userId);
      }

      function isCurrentPageOwner() {
        return isSignedIn()
          && currentPageOwnerId() == request.auth.uid;
      }

      function isIncomingPageOwner() {
        return isSignedIn()
          && incomingPageOwnerId() == request.auth.uid;
      }

      function hasPageManagementRole() {
        return isSignedIn()
          && exists(pageRolePath(request.auth.uid))
          && get(pageRolePath(request.auth.uid)).data.role in [
            'owner',
            'admin'
          ];
      }

      function canManageCurrentPage() {
        return isCurrentPageOwner() || hasPageManagementRole();
      }

      function hasSafeInitialVerificationState() {
        return request.resource.data.get('isVerified', false) == false
          && request.resource.data.get(
            'verificationState',
            'none'
          ) == 'none'
          && request.resource.data.get(
            'verificationApprovedAt',
            null
          ) == null
          && request.resource.data.get(
            'verificationReviewedBy',
            null
          ) == null;
      }

      function isValidVerificationPageUpdate() {
        let changedKeys =
          request.resource.data.diff(resource.data).affectedKeys();

        return isVerificationAdmin()
          && changedKeys.hasOnly([
            'isVerified',
            'verificationState',
            'verificationApprovedAt',
            'verificationReviewedBy',
            'verificationReviewerDisplayName',
            'updatedAt'
          ])
          && request.resource.data.get('isVerified', false) is bool
          && request.resource.data.get('verificationState', 'none') in [
            'none',
            'greyVerified',
            'blueVerified',
            'revoked'
          ]
          && isValidNullableTimestamp(
            request.resource.data.get('verificationApprovedAt', null)
          )
          && isValidOptionalString(
            request.resource.data.get('verificationReviewedBy', null),
            220
          )
          && isValidOptionalString(
            request.resource.data.get(
              'verificationReviewerDisplayName',
              null
            ),
            180
          )
          && request.resource.data.get('updatedAt', null) != null
          && (
            (
              request.resource.data.get('isVerified', false) == true
              && request.resource.data.get('verificationState', 'none') in [
                'greyVerified',
                'blueVerified'
              ]
              && request.resource.data.get(
                'verificationApprovedAt',
                null
              ) is timestamp
            )
            ||
            (
              request.resource.data.get('isVerified', false) == false
              && request.resource.data.get('verificationState', 'none') in [
                'none',
                'revoked'
              ]
              && request.resource.data.get(
                'verificationApprovedAt',
                null
              ) == null
            )
          );
      }

      function isVerificationMetadataUnchanged() {
        return request.resource.data.get(
            'isVerified',
            false
          ) == resource.data.get(
            'isVerified',
            false
          )
          && request.resource.data.get(
            'verificationState',
            'none'
          ) == resource.data.get(
            'verificationState',
            'none'
          )
          && request.resource.data.get(
            'verificationApprovedAt',
            null
          ) == resource.data.get(
            'verificationApprovedAt',
            null
          )
          && request.resource.data.get(
            'verificationReviewedBy',
            null
          ) == resource.data.get(
            'verificationReviewedBy',
            null
          );
      }

      function isValidPageCreate() {
        return isIncomingPageOwner()
          && hasSafeInitialVerificationState()
          && request.resource.data.id == pageId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.username is string
          && request.resource.data.username.size() > 1
          && request.resource.data.username.size() <= 80
          && request.resource.data.createdAt is timestamp
          && request.resource.data.followerCount is int
          && request.resource.data.followerCount == 0
          && request.resource.data.postCount is int
          && request.resource.data.postCount == 0;
      }

      function isValidManagedPageUpdate() {
        return canManageCurrentPage()
          && isVerificationMetadataUnchanged()
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerUserId == resource.data.ownerUserId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isValidFollowerCounterUpdate() {
        let changedKeys =
          request.resource.data.diff(resource.data).affectedKeys();

        return isSignedIn()
          && isVerificationMetadataUnchanged()
          && changedKeys.hasOnly([
            'followerCount',
            'updatedAt'
          ])
          && request.resource.data.followerCount is int
          && request.resource.data.followerCount >= 0
          && (
            request.resource.data.followerCount
              == resource.data.followerCount + 1
            ||
            (
              resource.data.followerCount > 0
              && request.resource.data.followerCount
                == resource.data.followerCount - 1
            )
          );
      }

      allow read: if isSignedIn();

      allow create: if isValidPageCreate();

      allow update: if isValidManagedPageUpdate()
        || isValidFollowerCounterUpdate()
        || isValidVerificationPageUpdate();

      allow delete: if isCurrentPageOwner();
      // -------------------------------------------------------------------
      // Page-Medien
      // Pfad: pages/{pageId}/media/{mediaId}
      // -------------------------------------------------------------------
      match /media/{mediaId} {
        function parentPagePath() {
          return /databases/$(database)/documents/pages/$(pageId);
        }

        function parentPageRolePath(userId) {
          return /databases/$(database)/documents/pages/$(pageId)/roles/$(userId);
        }

        function canManagePageMedia() {
          return isSignedIn()
            && exists(parentPagePath())
            && (
              get(parentPagePath()).data.ownerUserId == request.auth.uid
              ||
              (
                exists(parentPageRolePath(request.auth.uid))
                && get(parentPageRolePath(request.auth.uid)).data.role in [
                  'owner',
                  'admin'
                ]
              )
            );
        }

        allow read: if isSignedIn();

        allow create: if canManagePageMedia();

        allow update: if canManagePageMedia();

        allow delete: if canManagePageMedia();
      }
      // -------------------------------------------------------------------
      // Page-Beiträge
      // Pfad: pages/{pageId}/posts/{postId}
      // -------------------------------------------------------------------

      match /posts/{postId} {
        function parentPagePath() {
          return /databases/$(database)/documents/pages/$(pageId);
        }

        function parentPageRolePath(roleUserId) {
          return /databases/$(database)/documents/pages/$(pageId)/roles/$(roleUserId);
        }

        function parentPageExists() {
          return exists(parentPagePath());
        }

        function parentPageOwnerId() {
          return get(parentPagePath()).data.ownerUserId;
        }

        function currentPageRole() {
          return get(parentPageRolePath(request.auth.uid)).data.role;
        }

        function hasCurrentPageRole() {
          return isSignedIn()
            && exists(parentPageRolePath(request.auth.uid));
        }

        function isPagePostOwner() {
          return isSignedIn()
            && parentPageExists()
            && parentPageOwnerId() == request.auth.uid;
        }

        function canManagePagePosts() {
          return isPagePostOwner()
            || (
              hasCurrentPageRole()
              && currentPageRole() in [
                'owner',
                'admin',
                'editor'
              ]
            );
        }

        function canModeratePagePosts() {
          return canManagePagePosts()
            || (
              hasCurrentPageRole()
              && currentPageRole() == 'moderator'
            );
        }

        function isValidPagePostVisibility(value) {
          return value in [
            'internalOnly',
            'publicPreview',
            'publicLive'
          ];
        }

        function isValidPagePostType(value) {
          return value in [
            'text',
            'announcement',
            'update',
            'media',
            'event'
          ];
        }

        function isValidPagePostModerationStatus(value) {
          return value in [
            'clean',
            'pendingReview',
            'restricted',
            'removed'
          ];
        }

        function isValidPagePostDocument() {
          return request.resource.data.keys().hasOnly([
            'id',
            'pageId',
            'title',
            'body',
            'createdAt',
            'updatedAt',
            'reactionCount',
            'commentCount',
            'shareCount',
            'isPinned',
            'isFeatured',
            'visibility',
            'type',
            'moderationStatus'
          ])
          && request.resource.data.id == postId
          && request.resource.data.pageId == pageId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 180
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 10000
          && request.resource.data.createdAt is timestamp
          && isValidNullableTimestamp(
            request.resource.data.updatedAt
          )
          && request.resource.data.reactionCount is int
          && request.resource.data.reactionCount >= 0
          && request.resource.data.commentCount is int
          && request.resource.data.commentCount >= 0
          && request.resource.data.shareCount is int
          && request.resource.data.shareCount >= 0
          && request.resource.data.isPinned is bool
          && request.resource.data.isFeatured is bool
          && isValidPagePostVisibility(
            request.resource.data.visibility
          )
          && isValidPagePostType(
            request.resource.data.type
          )
          && isValidPagePostModerationStatus(
            request.resource.data.moderationStatus
          );
        }

        function isValidPagePostCreate() {
          return canManagePagePosts()
            && parentPageExists()
            && isValidPagePostDocument()
            && request.resource.data.reactionCount == 0
            && request.resource.data.commentCount == 0
            && request.resource.data.shareCount == 0;
        }

        function isValidManagedPagePostUpdate() {
          let changedKeys =
            request.resource.data.diff(resource.data).affectedKeys();

          return canManagePagePosts()
            && isValidPagePostDocument()
            && request.resource.data.id == resource.data.id
            && request.resource.data.pageId == resource.data.pageId
            && request.resource.data.createdAt == resource.data.createdAt
            && changedKeys.hasOnly([
              'title',
              'body',
              'updatedAt',
              'isPinned',
              'isFeatured',
              'visibility',
              'type',
              'moderationStatus'
            ]);
        }

        function isValidModerationOnlyUpdate() {
          let changedKeys =
            request.resource.data.diff(resource.data).affectedKeys();

          return canModeratePagePosts()
            && isValidPagePostDocument()
            && request.resource.data.id == resource.data.id
            && request.resource.data.pageId == resource.data.pageId
            && request.resource.data.createdAt == resource.data.createdAt
            && changedKeys.hasOnly([
              'moderationStatus',
              'updatedAt'
            ]);
        }

        function isValidReactionCounterIncrement() {
          let changedKeys =
            request.resource.data.diff(resource.data).affectedKeys();

          return isSignedIn()
            && changedKeys.hasOnly([
              'reactionCount'
            ])
            && request.resource.data.reactionCount
              == resource.data.reactionCount + 1;
        }

        function isValidCommentCounterIncrement() {
          let changedKeys =
            request.resource.data.diff(resource.data).affectedKeys();

          return isSignedIn()
            && changedKeys.hasOnly([
              'commentCount'
            ])
            && request.resource.data.commentCount
              == resource.data.commentCount + 1;
        }

        function isValidShareCounterIncrement() {
          let changedKeys =
            request.resource.data.diff(resource.data).affectedKeys();

          return isSignedIn()
            && changedKeys.hasOnly([
              'shareCount'
            ])
            && request.resource.data.shareCount
              == resource.data.shareCount + 1;
        }

        allow read: if isSignedIn()
          && (
            resource.data.visibility == 'publicLive'
            || canModeratePagePosts()
          );

        allow create: if isValidPagePostCreate();

        allow update: if isValidManagedPagePostUpdate()
          || isValidModerationOnlyUpdate()
          || isValidReactionCounterIncrement()
          || isValidCommentCounterIncrement()
          || isValidShareCounterIncrement();

        allow delete: if canManagePagePosts();
      }

      match /followingPages/{targetPageId} {
        function sourcePagePath() {
          return /databases/$(database)/documents/pages/$(pageId);
        }

        function sourcePageRolePath() {
          return /databases/$(database)/documents/pages/$(pageId)/roles/$(request.auth.uid);
        }

        function targetPagePath() {
          return /databases/$(database)/documents/pages/$(targetPageId);
        }

        function canActAsSourcePage() {
          return isSignedIn()
            && exists(sourcePagePath())
            && (
              get(sourcePagePath()).data.ownerUserId == request.auth.uid
              ||
              (
                exists(sourcePageRolePath())
                && get(sourcePageRolePath()).data.role in [
                  'owner',
                  'admin',
                  'editor'
                ]
              )
            );
        }

        allow read: if isSignedIn();

        allow create: if canActAsSourcePage()
          && targetPageId != pageId
          && exists(targetPagePath())
          && request.resource.data.keys().hasOnly([
            'sourcePageId',
            'targetPageId',
            'operatedByUserId',
            'followedAt'
          ])
          && request.resource.data.sourcePageId == pageId
          && request.resource.data.targetPageId == targetPageId
          && request.resource.data.operatedByUserId == request.auth.uid
          && request.resource.data.followedAt != null;

        allow update: if false;

        allow delete: if canActAsSourcePage();
      }

      match /followers/{userId} {
        function parentPagePath() {
          return /databases/$(database)/documents/pages/$(pageId);
        }

        function parentPageRolePath(roleUserId) {
          return /databases/$(database)/documents/pages/$(pageId)/roles/$(roleUserId);
        }

        function canManageParentPage() {
          return isSignedIn()
            && (
              get(parentPagePath()).data.ownerUserId == request.auth.uid
              ||
              (
                exists(parentPageRolePath(request.auth.uid))
                && get(parentPageRolePath(request.auth.uid)).data.role in [
                  'owner',
                  'admin'
                ]
              )
            );
        }

        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.pageId == pageId
          && request.resource.data.followedAt != null;

        allow update: if false;

        allow delete: if (
          isSignedIn()
          && userId == request.auth.uid
        ) || canManageParentPage();
      }

      match /roles/{userId} {
        function parentPagePath() {
          return /databases/$(database)/documents/pages/$(pageId);
        }

        function parentPageRolePath(roleUserId) {
          return /databases/$(database)/documents/pages/$(pageId)/roles/$(roleUserId);
        }

        function canManageParentPage() {
          return isSignedIn()
            && (
              get(parentPagePath()).data.ownerUserId == request.auth.uid
              ||
              (
                exists(parentPageRolePath(request.auth.uid))
                && get(parentPageRolePath(request.auth.uid)).data.role in [
                  'owner',
                  'admin'
                ]
              )
            );
        }

        allow read: if isSignedIn();

        allow create: if (
          isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.pageId == pageId
          && request.resource.data.role == 'owner'
          && getAfter(parentPagePath()).data.ownerUserId == request.auth.uid
        ) || canManageParentPage();

        allow update, delete: if canManageParentPage();
      }

      match /blockedUsers/{userId} {
        function parentPagePath() {
          return /databases/$(database)/documents/pages/$(pageId);
        }

        function parentPageRolePath(roleUserId) {
          return /databases/$(database)/documents/pages/$(pageId)/roles/$(roleUserId);
        }

        function canManageParentPage() {
          return isSignedIn()
            && (
              get(parentPagePath()).data.ownerUserId == request.auth.uid
              ||
              (
                exists(parentPageRolePath(request.auth.uid))
                && get(parentPageRolePath(request.auth.uid)).data.role in [
                  'owner',
                  'admin'
                ]
              )
            );
        }

        function isSelfPageBlockCreate() {
          return isSignedIn()
            && userId == request.auth.uid
            && request.resource.data.keys().hasOnly([
              'pageId',
              'userId',
              'blockedAt',
              'source'
            ])
            && request.resource.data.pageId == pageId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.blockedAt is timestamp
            && request.resource.data.source is string
            && request.resource.data.source.size() > 0
            && request.resource.data.source.size() <= 80
            && get(parentPagePath()).data.ownerUserId != request.auth.uid;
        }

        allow read: if canManageParentPage()
          || (
            isSignedIn()
            && userId == request.auth.uid
          );

        allow create: if canManageParentPage()
          || isSelfPageBlockCreate();

        allow update: if canManageParentPage();

        allow delete: if canManageParentPage()
          || (
            isSignedIn()
            && userId == request.auth.uid
          );
      }
    }

    match /page_usernames/{normalizedUsername} {
      function incomingPagePath() {
        return /databases/$(database)/documents/pages/$(request.resource.data.pageId);
      }

      function existingPagePath() {
        return /databases/$(database)/documents/pages/$(resource.data.pageId);
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.pageId is string
        && request.resource.data.pageId.size() > 0
        && request.resource.data.username == normalizedUsername
        && getAfter(incomingPagePath()).data.ownerUserId == request.auth.uid;

      allow update: if false;

      allow delete: if isSignedIn()
        && get(existingPagePath()).data.ownerUserId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Zentraler Account-Enforcement-Status
    // ---------------------------------------------------------------------
    match /accountEnforcementStates/{userId} {
      // Der betroffene Nutzer darf ausschließlich seinen eigenen Status
      // lesen. Berechtigte Luma-Admins dürfen Kontostatus prüfen.
      // Ausnahme von der globalen Sperre:
      // Der betroffene Nutzer muss seinen eigenen Enforcement-State weiterhin
      // lesen dürfen. Sonst könnte die App weder Sperrgrund noch eine spätere
      // Entsperrung erkennen.
      allow get: if (
          isAuthenticated()
          && request.auth.uid == userId
        )
        || isLumaAdmin();
      allow list: if isLumaAdmin();

      // Sperren und sonstige Kontomaßnahmen werden nicht direkt aus der
      // Flutter-App geschrieben. Schreibzugriffe erfolgen ausschließlich
      // über eine vertrauenswürdige Serverumgebung / Firebase Admin SDK.
      allow create, update, delete: if false;
    }


    // ---------------------------------------------------------------------
    // Widersprüche gegen Account-Enforcement
    // ---------------------------------------------------------------------
    match /accountEnforcementAppeals/{appealId} {
      // Der betroffene Nutzer darf ein bestehendes Ticket sehen, solange
      // er authentifiziert ist. Nach der automatischen Sperr-Abmeldung
      // erfolgt die Einreichung ausschließlich über die token-geschützte
      // Cloud Function.
      allow get: if isLumaAdmin()
        || (
          isSignedIn()
          && resource.data.get('userId', '') == request.auth.uid
        );

      allow list: if isLumaAdmin();

      // Erstellung und Entscheidungen erfolgen ausschließlich serverseitig.
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Interne Administratoren
    // ---------------------------------------------------------------------
    match /admins/{adminId} {
      // Ein Nutzer darf ausschließlich sein eigenes Admin-Dokument abrufen.
      // Bereits autorisierte Administratoren dürfen andere Admin-Dokumente
      // lesen, etwa für interne Verwaltungsansichten.
      allow get: if isSignedIn()
        && (
          adminId == request.auth.uid
          || isVerificationAdmin()
        );

      allow list: if isVerificationAdmin();

      // Adminrollen werden niemals aus der Client-App heraus vergeben oder
      // verändert. Solche Änderungen gehören in eine vertrauenswürdige
      // Serverumgebung bzw. die Firebase Admin SDK.
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Verifikationsanträge
    // ---------------------------------------------------------------------
    match /verification_requests/{requestId} {
      function targetPagePath() {
        return /databases/$(database)/documents/pages/$(request.resource.data.targetId);
      }

      function targetPageRolePath() {
        return /databases/$(database)/documents/pages/$(request.resource.data.targetId)/roles/$(request.auth.uid);
      }

      function canSubmitForIncomingTarget() {
        return request.resource.data.targetType == 'profile'
          ? request.resource.data.targetId == request.auth.uid
          : (
              request.resource.data.targetType == 'page'
              && exists(targetPagePath())
              && (
                get(targetPagePath()).data.ownerUserId == request.auth.uid
                || (
                  exists(targetPageRolePath())
                  && get(targetPageRolePath()).data.role in [
                    'owner',
                    'admin'
                  ]
                )
              )
            );
      }

      function hasValidVerificationRequestShape() {
        return request.resource.data.keys().hasOnly([
          'requestId',
          'userId',
          'targetType',
          'targetId',
          'targetName',
          'type',
          'fullName',
          'description',
          'submittedLinks',
          'documentUrls',
          'status',
          'isOpen',
          'rejectionReason',
          'reviewerUserId',
          'reviewNotes',
          'createdAt',
          'updatedAt',
          'submittedAt',
          'reviewedAt',
          'approvedAt',
          'rejectedAt'
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.targetType in ['profile', 'page']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 220
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() > 0
        && request.resource.data.targetName.size() <= 160
        && request.resource.data.type in ['grey', 'blue']
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 6000
        && request.resource.data.submittedLinks is list
        && request.resource.data.submittedLinks.size() <= 40
        && request.resource.data.documentUrls is list
        && request.resource.data.documentUrls.size() <= 20
        && request.resource.data.status == 'pending'
        && request.resource.data.isOpen == true
        && request.resource.data.rejectionReason == null
        && request.resource.data.reviewerUserId == null
        && request.resource.data.reviewNotes == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.approvedAt == null
        && request.resource.data.rejectedAt == null
        && canSubmitForIncomingTarget();
      }

      function isValidAdminStatusTransition() {
        return (
            resource.data.status == 'pending'
            && request.resource.data.status in [
              'pending',
              'underReview',
              'approved',
              'rejected'
            ]
          )
          || (
            resource.data.status == 'underReview'
            && request.resource.data.status in [
              'underReview',
              'approved',
              'rejected'
            ]
          )
          || (
            resource.data.status == 'approved'
            && request.resource.data.status in [
              'approved',
              'revoked'
            ]
          )
          || (
            resource.data.status in ['rejected', 'revoked']
            && request.resource.data.status == resource.data.status
          );
      }

      function isValidAdminUpdate() {
        let changedKeys =
          request.resource.data.diff(resource.data).affectedKeys();

        return isVerificationAdmin()
          && changedKeys.hasOnly([
            'status',
            'isOpen',
            'rejectionReason',
            'reviewerUserId',
            'reviewNotes',
            'updatedAt',
            'reviewedAt',
            'approvedAt',
            'rejectedAt'
          ])
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.targetType == resource.data.targetType
          && request.resource.data.targetId == resource.data.targetId
          && request.resource.data.targetName == resource.data.targetName
          && request.resource.data.type == resource.data.type
          && request.resource.data.fullName == resource.data.fullName
          && request.resource.data.description == resource.data.description
          && request.resource.data.submittedLinks ==
              resource.data.submittedLinks
          && request.resource.data.documentUrls ==
              resource.data.documentUrls
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.submittedAt == resource.data.submittedAt
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.isOpen ==
              (
                request.resource.data.status == 'pending'
                || request.resource.data.status == 'underReview'
              )
          && isValidNullableTimestamp(
            request.resource.data.reviewedAt
          )
          && isValidNullableTimestamp(
            request.resource.data.approvedAt
          )
          && isValidNullableTimestamp(
            request.resource.data.rejectedAt
          )
          && isValidOptionalString(
            request.resource.data.rejectionReason,
            2000
          )
          && isValidOptionalString(
            request.resource.data.reviewerUserId,
            220
          )
          && isValidOptionalString(
            request.resource.data.reviewNotes,
            4000
          )
          && isValidAdminStatusTransition()
          && (
            request.resource.data.status != 'approved'
            || (
              request.resource.data.isOpen == false
              && request.resource.data.approvedAt is timestamp
              && request.resource.data.reviewedAt is timestamp
              && request.resource.data.rejectedAt == null
              && request.resource.data.rejectionReason == null
            )
          )
          && (
            request.resource.data.status != 'rejected'
            || (
              request.resource.data.isOpen == false
              && request.resource.data.rejectedAt is timestamp
              && request.resource.data.reviewedAt is timestamp
              && request.resource.data.rejectionReason is string
              && request.resource.data.rejectionReason.size() > 0
              && request.resource.data.approvedAt == null
            )
          )
          && (
            request.resource.data.status != 'revoked'
            || (
              request.resource.data.isOpen == false
              && request.resource.data.reviewedAt is timestamp
              && request.resource.data.rejectionReason is string
              && request.resource.data.rejectionReason.size() > 0
              && request.resource.data.approvedAt is timestamp
              && request.resource.data.rejectedAt == null
            )
          );
      }

      allow create: if isSignedIn()
        && hasValidVerificationRequestShape();

      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isVerificationAdmin()
        );

      allow update: if isValidAdminUpdate();

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Collection-Group-Lookup für eigene Page-Follows
    //
    // Wird vom Onboarding verwendet:
    //
    // FirebaseFirestore.instance
    //   .collectionGroup('followers')
    //   .where('userId', isEqualTo: request.auth.uid)
    //
    // Die list-Regel prüft bewusst das gespeicherte Feld userId. Dadurch
    // kann Firestore anhand der where-Bedingung beweisen, dass ausschließlich
    // Follow-Dokumente des angemeldeten Nutzers zurückgegeben werden.
    //
    // Die bestehenden Schreibregeln unter
    // pages/{pageId}/followers/{userId}
    // bleiben unverändert und weiterhin maßgeblich.
    // ---------------------------------------------------------------------
    match /{path=**}/followers/{followerUserId} {
      allow get: if isSignedIn()
        && (
          followerUserId == request.auth.uid
          || resource.data.userId == request.auth.uid
        );

      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }


    // ---------------------------------------------------------------------
    // Luma Account-Enforcement Administration
    // ---------------------------------------------------------------------
    match /accountEnforcements/{enforcementId} {
      allow get, list: if isLumaAdmin();
      allow create, update, delete: if false;
    }

    match /moderationCases/{caseId} {
      allow get, list: if isLumaAdmin();
      allow create, update, delete: if false;
    }

    match /adminAuditLogs/{auditId} {
      allow get, list: if isLumaAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
