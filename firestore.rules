        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() > 0
        && request.resource.data.conversationId.size() <= 220
        && request.resource.data.callerUserId == request.auth.uid
        && request.resource.data.receiverUserId is string
        && request.resource.data.receiverUserId.size() > 0
        && request.resource.data.receiverUserId != request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.receiverUserId in request.resource.data.participantIds
        && isValidCallType(request.resource.data.type)
        && request.resource.data.status == 'ringing'
        && request.resource.data.createdAt != null
        && request.resource.data.updatedAt != null
        && isValidNullableTimestamp(request.resource.data.acceptedAt)
        && isValidNullableTimestamp(request.resource.data.declinedAt)
        && isValidNullableTimestamp(request.resource.data.endedAt)
        && isValidNullableTimestamp(request.resource.data.missedAt)
        && isValidNullableTimestamp(request.resource.data.failedAt)
        && request.resource.data.isCallerMuted is bool
        && request.resource.data.isReceiverMuted is bool
        && request.resource.data.isCallerCameraEnabled is bool
        && request.resource.data.isReceiverCameraEnabled is bool
        && request.resource.data.isSpeakerEnabled is bool
        && isValidOptionalString(request.resource.data.failureReason, 500)
        && (
          !('channelId' in request.resource.data)
          || (
            request.resource.data.channelId is string
            && request.resource.data.channelId.size() > 0
            && request.resource.data.channelId.size() <= 220
          )
        )
        && (
          !('token' in request.resource.data)
          || isValidOptionalString(request.resource.data.token, 4096)
        );
