    function isValidNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isValidSecurityDeviceSummary(summary) {
      return summary is map
        && summary.keys().hasOnly([
          'trustedDeviceCount',
          'activeSessionCount',
          'lastDeviceActivityAt'
        ])
        && summary.trustedDeviceCount is int
        && summary.trustedDeviceCount >= 0
        && summary.activeSessionCount is int
        && summary.activeSessionCount >= 0
        && isValidNullableTimestamp(summary.lastDeviceActivityAt);
    }

    function isValidSecurityTimelineSummary(summary) {
      return summary is map
        && summary.keys().hasOnly([
          'lastSuccessfulLoginAt',
          'lastPasswordChangedAt',
          'lastSecurityEventAt',
          'unreadSecurityEventCount'
        ])
        && isValidNullableTimestamp(summary.lastSuccessfulLoginAt)
        && isValidNullableTimestamp(summary.lastPasswordChangedAt)
        && isValidNullableTimestamp(summary.lastSecurityEventAt)
        && summary.unreadSecurityEventCount is int
        && summary.unreadSecurityEventCount >= 0;
