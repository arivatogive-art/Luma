    function isCallParticipant() {
      return isSignedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    function isValidCallType(type) {
      return type in ['voice', 'video'];
    }

    function isValidCallStatus(status) {
      return status in ['ringing', 'accepted', 'declined', 'missed', 'ended', 'failed'];
    }

    function isValidCallCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'conversationId',
          'callerUserId',
          'receiverUserId',
          'participantIds',
          'type',
          'status',
          'createdAt',
          'updatedAt',
          'acceptedAt',
          'declinedAt',
          'endedAt',
          'missedAt',
          'failedAt',
          'isCallerMuted',
          'isReceiverMuted',
          'isCallerCameraEnabled',
          'isReceiverCameraEnabled',
          'isSpeakerEnabled',
          'failureReason',
          'channelId',
          'token'
